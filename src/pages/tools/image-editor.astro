---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import ShareBar from "@/components/ShareBar.astro";

const title = "Free Image Editor for Freelancers | Retainr";
const description = "Adjust brightness, contrast, and saturation, rotate or flip, then export PNG or JPEG images privately in your browser. Free with no signup or upload.";
const path = "/tools/image-editor/";
const site = Astro.site ?? "https://www.retainr.io";
const faqs = [
  {
    question: "Is the Retainr image editor free to use?",
    answer: "Yes. You can open, adjust, and export an image without creating an account, entering an email address, or paying for the download.",
  },
  {
    question: "Does Retainr upload or store my image?",
    answer: "No. The selected image is decoded and edited in your browser. Retainr does not receive or store the image file you open in this tool.",
  },
  {
    question: "Which image formats are supported?",
    answer: "The editor accepts PNG, JPEG, and WebP images. It exports a newly encoded PNG or JPEG file.",
  },
  {
    question: "Does the editor keep the original resolution and metadata?",
    answer: "Images with a side longer than 2,400 pixels are reduced proportionally for browser-safe processing. Export creates a new image and may not preserve EXIF metadata, embedded color profiles, animation, layers, or transparency when JPEG is selected.",
  },
  {
    question: "When is this editor appropriate for client work?",
    answer: "Use it for quick brightness, contrast, saturation, orientation, and format changes when you have permission to edit the image. Use a full design or photo application for precise retouching, print color management, layered files, or production-critical exports.",
  },
];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": new URL(`${path}#tool`, site).toString(),
      name: "Retainr Free Private Image Editor",
      description,
      url: new URL(path, site).toString(),
      applicationCategory: "MultimediaApplication",
      operatingSystem: "Any operating system with a modern web browser",
      browserRequirements: "JavaScript, HTML Canvas, and a modern browser",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
      featureList: [
        "Local browser image processing",
        "Brightness adjustment",
        "Contrast adjustment",
        "Saturation adjustment",
        "Left and right rotation",
        "Horizontal flip",
        "PNG and JPEG export",
      ],
      audience: { "@type": "Audience", audienceType: "Freelancers, designers, content creators, consultants, and small studios" },
      creator: { "@id": "https://www.retainr.io/#pierre-henry" },
      isPartOf: { "@id": "https://www.retainr.io/#website" },
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Retainr", item: new URL("/", site).toString() },
        { "@type": "ListItem", position: 2, name: "Free Tools", item: new URL("/tools/", site).toString() },
        { "@type": "ListItem", position: 3, name: "Private Image Editor", item: new URL(path, site).toString() },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} path={path}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <section class="image-editor-hero">
    <div class="container image-editor-heading">
      <div>
        <nav class="tool-breadcrumb" aria-label="Breadcrumb"><a href="/tools/">Free Tools</a><span>/</span><span>Private Image Editor</span></nav>
        <span class="eyebrow">Free creator tool</span>
        <h1>Make the image ready. Keep the client work moving.</h1>
      </div>
      <div class="image-editor-hero-note">
        <p>Your image stays in your browser. Retainr does not upload or store it.</p>
        <strong>No signup · No email · No paid export</strong>
      </div>
    </div>
  </section>

  <section class="image-editor-section" aria-labelledby="image-editor-title">
    <div class="container image-editor-shell" data-image-editor>
      <div class="image-editor-toolbar">
        <div>
          <span class="editor-step">01</span>
          <h2 id="image-editor-title">Choose an image</h2>
        </div>
        <label class="button yellow editor-upload" for="image-editor-upload">Open image</label>
        <input
          id="image-editor-upload"
          class="visually-hidden"
          type="file"
          accept="image/jpeg,image/png,image/webp"
        />
      </div>

      <div class="image-editor-workspace">
        <div class="image-editor-stage" data-editor-stage>
          <div class="image-editor-empty" data-editor-empty>
            <label
              class="image-editor-empty-open"
              for="image-editor-upload"
              data-editor-open
              role="button"
              tabindex="0"
              aria-label="Open an image from your device"
              aria-controls="image-editor-upload"
              title="Open image"
            >
              <span aria-hidden="true">+</span>
            </label>
            <strong>No image open</strong>
            <small>PNG, JPEG, or WebP</small>
          </div>
          <canvas data-editor-canvas hidden></canvas>
        </div>

        <aside class="image-editor-controls" aria-label="Image adjustments">
          <div class="editor-control-heading">
            <span class="editor-step">02</span>
            <h2>Adjust</h2>
          </div>

          <label class="editor-slider">
            <span>Brightness <output data-output="brightness">100%</output></span>
            <input data-adjustment="brightness" type="range" min="0" max="200" value="100" disabled />
          </label>
          <label class="editor-slider">
            <span>Contrast <output data-output="contrast">100%</output></span>
            <input data-adjustment="contrast" type="range" min="0" max="200" value="100" disabled />
          </label>
          <label class="editor-slider">
            <span>Saturation <output data-output="saturation">100%</output></span>
            <input data-adjustment="saturation" type="range" min="0" max="200" value="100" disabled />
          </label>

          <div class="editor-transform-grid">
            <button type="button" data-transform="rotate-left" disabled>Rotate left</button>
            <button type="button" data-transform="rotate-right" disabled>Rotate right</button>
            <button type="button" data-transform="flip" disabled>Flip horizontal</button>
            <button type="button" data-transform="reset" disabled>Reset</button>
          </div>

          <div class="editor-export">
            <label for="image-editor-format">Format</label>
            <select id="image-editor-format" data-editor-format disabled>
              <option value="image/png">PNG</option>
              <option value="image/jpeg">JPEG</option>
            </select>
            <button class="button" type="button" data-editor-download disabled>Download image</button>
          </div>

          <p class="editor-status" data-editor-status aria-live="polite">Open an image to begin.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section tool-explanation-section" aria-labelledby="image-editor-purpose">
    <div class="container tool-explanation-grid">
      <div>
        <span class="eyebrow">What this tool does</span>
        <h2 id="image-editor-purpose">Handle the quick correction without sending the file elsewhere.</h2>
        <p>Use the editor when a client asset needs a straightforward visual adjustment before a presentation, proposal, portal update, social post, or delivery. It is designed for speed and privacy, not layered design production.</p>
      </div>
      <div class="tool-context-cards">
        <article><strong>Good for</strong><p>Brightness, contrast, saturation, orientation, horizontal flipping, and PNG or JPEG export.</p></article>
        <article><strong>Private by design</strong><p>The selected file is processed with browser canvas APIs and is not uploaded to Retainr.</p></article>
        <article><strong>Know the boundary</strong><p>The longest side is capped at 2,400 pixels. Exports may not preserve metadata, profiles, layers, or animation.</p></article>
      </div>
    </div>
  </section>

  <section class="section ice tool-steps-section" aria-labelledby="image-editor-steps">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">How to edit an image</span>
        <h2 id="image-editor-steps">Four steps from source file to client-ready export.</h2>
      </div>
      <ol class="tool-step-list">
        <li><span>01</span><div><strong>Open a PNG, JPEG, or WebP image</strong><p>Choose a file from your device. The file remains inside the current browser session.</p></div></li>
        <li><span>02</span><div><strong>Adjust only what the image needs</strong><p>Change brightness, contrast, or saturation while checking that skin tones, brand colors, and important detail remain credible.</p></div></li>
        <li><span>03</span><div><strong>Correct the orientation</strong><p>Rotate left or right, flip horizontally, or reset every adjustment to return to the loaded image.</p></div></li>
        <li><span>04</span><div><strong>Choose PNG or JPEG and download</strong><p>Use PNG when transparency matters. Use JPEG for a smaller photographic file when transparency is not required.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section tool-related-section" aria-labelledby="image-editor-related-title">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">Continue the work</span><h2 id="image-editor-related-title">Free resources around the client asset.</h2></div>
      <div class="tool-related-links">
        <a href="/tools/freelance-client-onboarding-checklist/"><span>Before delivery</span><strong>Prepare the client onboarding checklist</strong><small>Free browser generator →</small></a>
        <a href="/guides/agency-freelancing-skills-you-need-to-know/"><span>Shape the offer</span><strong>Choose a valuable freelance skill</strong><small>Free 13-page workbook →</small></a>
        <a href="/client-portal-client-management-software/"><span>Deliver professionally</span><strong>Keep client files with the relationship</strong><small>Explore the Retainr portal →</small></a>
      </div>
    </div>
  </section>

  <section class="section ice tool-faq-section" aria-labelledby="image-editor-faq-title">
    <div class="container faq-layout">
      <div class="section-heading"><span class="eyebrow">Image Editor FAQ</span><h2 id="image-editor-faq-title">Privacy, formats, quality, and appropriate use.</h2></div>
      <div class="faq-list">
        {faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
      </div>
    </div>
  </section>

  <section class="section tool-share-section"><div class="container"><ShareBar title="Retainr Free Private Image Editor" description={description} path={path} surface="private-image-editor" /></div></section>

  <CtaBand
    title="When one image becomes an ongoing client workflow"
    text="Retainr keeps client files, requests, approvals, tasks, support, and recurring services connected in one branded workspace. Every feature is free forever."
  />
</BaseLayout>

<script>
  const editor = document.querySelector<HTMLElement>("[data-image-editor]");

  if (editor) {
    const upload = editor.querySelector<HTMLInputElement>("#image-editor-upload");
    const canvas = editor.querySelector<HTMLCanvasElement>("[data-editor-canvas]");
    const empty = editor.querySelector<HTMLElement>("[data-editor-empty]");
    const open = editor.querySelector<HTMLElement>("[data-editor-open]");
    const status = editor.querySelector<HTMLElement>("[data-editor-status]");
    const format = editor.querySelector<HTMLSelectElement>("[data-editor-format]");
    const download = editor.querySelector<HTMLButtonElement>("[data-editor-download]");
    const adjustments = [...editor.querySelectorAll<HTMLInputElement>("[data-adjustment]")];
    const transforms = [...editor.querySelectorAll<HTMLButtonElement>("[data-transform]")];
    const controls = [...adjustments, ...transforms, ...(format ? [format] : []), ...(download ? [download] : [])];
    const context = canvas?.getContext("2d");
    const image = new Image();
    let objectUrl = "";
    let rotation = 0;
    let flipped = false;

    const adjustmentValue = (name: string) =>
      adjustments.find((input) => input.dataset.adjustment === name)?.value ?? "100";

    const setEnabled = (enabled: boolean) => {
      controls.forEach((control) => {
        control.disabled = !enabled;
      });
    };

    const render = () => {
      if (!canvas || !context || !image.naturalWidth) return;

      const maxDimension = 2400;
      const scale = Math.min(1, maxDimension / Math.max(image.naturalWidth, image.naturalHeight));
      const imageWidth = Math.round(image.naturalWidth * scale);
      const imageHeight = Math.round(image.naturalHeight * scale);
      const quarterTurn = Math.abs(rotation / 90) % 2 === 1;
      canvas.width = quarterTurn ? imageHeight : imageWidth;
      canvas.height = quarterTurn ? imageWidth : imageHeight;

      context.clearRect(0, 0, canvas.width, canvas.height);
      context.save();
      context.translate(canvas.width / 2, canvas.height / 2);
      context.rotate((rotation * Math.PI) / 180);
      context.scale(flipped ? -1 : 1, 1);
      context.filter = `brightness(${adjustmentValue("brightness")}%) contrast(${adjustmentValue("contrast")}%) saturate(${adjustmentValue("saturation")}%)`;
      context.drawImage(image, -imageWidth / 2, -imageHeight / 2, imageWidth, imageHeight);
      context.restore();
    };

    const reset = () => {
      rotation = 0;
      flipped = false;
      adjustments.forEach((input) => {
        input.value = "100";
        const output = editor.querySelector<HTMLOutputElement>(`[data-output="${input.dataset.adjustment}"]`);
        if (output) output.value = "100%";
      });
      render();
      if (status) status.textContent = "Adjustments reset.";
    };

    const showImagePrompt = () => {
      if (status) status.textContent = "Choose a PNG, JPEG, or WebP image.";
    };

    open?.addEventListener("click", showImagePrompt);
    open?.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      event.preventDefault();
      showImagePrompt();
      upload?.click();
    });

    upload?.addEventListener("change", () => {
      const file = upload.files?.[0];
      if (!file) return;

      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = URL.createObjectURL(file);
      image.onload = () => {
        reset();
        setEnabled(true);
        if (canvas) canvas.hidden = false;
        if (empty) empty.hidden = true;
        if (status) status.textContent = `${file.name} ready - ${image.naturalWidth} x ${image.naturalHeight}px.`;
      };
      image.onerror = () => {
        if (status) status.textContent = "This image could not be opened.";
      };
      image.src = objectUrl;
    });

    adjustments.forEach((input) => {
      input.addEventListener("input", () => {
        const output = editor.querySelector<HTMLOutputElement>(`[data-output="${input.dataset.adjustment}"]`);
        if (output) output.value = `${input.value}%`;
        render();
      });
    });

    transforms.forEach((button) => {
      button.addEventListener("click", () => {
        if (button.dataset.transform === "rotate-left") rotation -= 90;
        if (button.dataset.transform === "rotate-right") rotation += 90;
        if (button.dataset.transform === "flip") flipped = !flipped;
        if (button.dataset.transform === "reset") {
          reset();
          return;
        }
        render();
      });
    });

    download?.addEventListener("click", () => {
      if (!canvas || !format) return;
      const mime = format.value;
      const exportCanvas = document.createElement("canvas");
      exportCanvas.width = canvas.width;
      exportCanvas.height = canvas.height;
      const exportContext = exportCanvas.getContext("2d");
      if (!exportContext) return;

      if (mime === "image/jpeg") {
        exportContext.fillStyle = "#ffffff";
        exportContext.fillRect(0, 0, exportCanvas.width, exportCanvas.height);
      }
      exportContext.drawImage(canvas, 0, 0);
      exportCanvas.toBlob((blob) => {
        if (!blob) return;
        const link = document.createElement("a");
        const extension = mime === "image/jpeg" ? "jpg" : "png";
        const url = URL.createObjectURL(blob);
        link.href = url;
        link.download = `retainr-edited-image.${extension}`;
        document.body.append(link);
        link.click();
        link.remove();
        window.setTimeout(() => URL.revokeObjectURL(url), 1_000);
        if (status) status.textContent = `Downloaded ${link.download}.`;
      }, mime, 0.92);
    });

    window.addEventListener("pagehide", () => {
      if (objectUrl) URL.revokeObjectURL(objectUrl);
    });
  }
</script>
