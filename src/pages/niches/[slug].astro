---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import GuaranteeBand from "@/components/GuaranteeBand.astro";
import { niches } from "@/data/niches";
import { signupUrl } from "@/data/site";

export function getStaticPaths() {
  return niches.map((niche) => ({
    params: { slug: niche.slug },
    props: { niche },
  }));
}

const { niche } = Astro.props;
const nicheSignupUrl = `${signupUrl}?niche=${niche.slug}`;
---

<BaseLayout
  title={`${niche.name} | Retainr — The Retainr Method`}
  description={niche.subhero}
  path={`/niches/${niche.slug}/`}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">The Retainr Method</span>
        <h1>{niche.hero}</h1>
        <p class="lead">{niche.subhero}</p>
        <div class="hero-actions">
          <a href={nicheSignupUrl} class="button">Start Your Retainer Engine</a>
          <a href="/pricing/" class="button ghost">See Pricing</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="product-frame">
          <img src="/assets/dashboard-hero.png" alt={niche.name} loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Pain Points -->
  <section class="section">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">The Problem</span>
        <h2>You’re great at what you do.<br />But the business side is exhausting.</h2>
      </div>
      <div class="feature-grid">
        {niche.painPoints?.map((point) => (
          <article class="feature-card">
            <h3>{point}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- The Retainr Method -->
  <section class="section ice">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">The Retainr Method</span>
        <h2>How {niche.name.split(" ")[0]} pros build predictable revenue</h2>
      </div>
      <div class="feature-grid">
        <article class="feature-card"><div class="feature-icon">1</div><h3>Package Your Expertise</h3><p>Turn what you do into clear, buyable offers.</p></article>
        <article class="feature-card"><div class="feature-icon">2</div><h3>Publish & Sell Instantly</h3><p>Launch branded offers. Get paid before you start.</p></article>
        <article class="feature-card"><div class="feature-icon">3</div><h3>Automated Onboarding</h3><p>Magic links + niche-specific intake questions.</p></article>
        <article class="feature-card"><div class="feature-icon">4</div><h3>Deliver in Your Brand Portal</h3><p>White-label experience that builds trust.</p></article>
        <article class="feature-card"><div class="feature-icon">5</div><h3>Convert to Recurring</h3><p>Turn one-time wins into monthly retainers.</p></article>
        <article class="feature-card"><div class="feature-icon">6</div><h3>Stabilize Revenue</h3><p>Automatic billing, renewals, and health dashboards.</p></article>
      </div>
    </div>
  </section>

  <!-- Example Offers -->
  <section class="section">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">Ready-to-sell offers</span>
        <h2>Example packages {niche.name.split(" ")[0]} are selling today</h2>
      </div>
      <div class="feature-grid">
        {niche.offers.map((offer, index) => (
          <article class="feature-card">
            <div class="feature-icon" style="background: var(--yellow); color: var(--ink);">{index + 1}</div>
            <h3>{offer}</h3>
            <a href={nicheSignupUrl} class="button ghost" style="margin-top: auto; width: fit-content;">Sell this offer →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Guarantee Band -->
  <GuaranteeBand
    title={`Built for ${niche.name.split(" ")[0]} — With Zero Risk`}
    subtitle="Test Retainr for your niche. If it doesn’t help you sell retainers, we’ll make it right."
  />

  <!-- Final Strong CTA -->
  <section class="section">
    <div class="container" style="max-width: 720px; text-align: center;">
      <h2>Ready to turn your {niche.name.toLowerCase()} expertise into a retainer engine?</h2>
      <a href={nicheSignupUrl} class="button" style="font-size: 1.1rem; padding: 0 36px; min-height: 56px; margin-top: 20px;">
        Start Selling Today — {niche.name.split(" ")[0]} Plan
      </a>
      <p style="margin-top: 16px; color: var(--muted);">No credit card required. 14-day free trial.</p>
    </div>
  </section>

  <CtaBand 
    title="Not sure if it fits your workflow?"
    text="Start free and explore the niche-specific tools yourself."
    cta="Start Free Trial"
    href={nicheSignupUrl}
  />
</BaseLayout>