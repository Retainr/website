---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import Testimonials from "@/components/Testimonials.astro";
import GuaranteeBand from "@/components/GuaranteeBand.astro";
import NicheIcon from "@/components/NicheIcon.astro";
import NicheSignupVisual from "@/components/NicheSignupVisual.astro";
import { signupUrl } from "@/data/site";
import { featuredNiches, niches, type Niche } from "@/data/niches";

export function getStaticPaths() {
  return niches.map((niche) => ({
    params: { slug: niche.slug },
    props: { niche },
  }));
}

const { niche } = Astro.props as { niche: Niche };
const nicheSignupUrl = `${signupUrl}?niche=${niche.slug}`;
const nicheCount = niches.length;
const relatedNiches = featuredNiches.filter((item) => item.slug !== niche.slug).slice(0, 3);
const relatedNicheCount = relatedNiches.length;
const systemLabel = `The System for ${niche.name}`;
const finalCtaText = "Start Your $1 Trial";
const offerLadder = niche.offers.slice(0, 3);
---

<BaseLayout
  title={`${niche.name} | ${niche.hero}`}
  description={niche.subhero}
  path={`/niches/${niche.slug}/`}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{systemLabel}</span>
        <h1>{niche.hero}</h1>
        <p>{niche.subhero}</p>
        <p>
          The Retainr Method gives you a clear, repeatable system to package your skills, 
          sell with confidence, deliver professionally, and turn one-time clients into predictable monthly revenue.
        </p>
        <div class="hero-actions">
          <a href={nicheSignupUrl} class="button">Start Your $1 Trial</a>
          <a href="#method" class="button ghost">See The Method</a>
        </div>
        <div class="hero-proof">
          <div class="proof-pill"><strong>0%</strong><span>transaction fees</span></div>
          <div class="proof-pill"><strong>100%</strong><span>white label</span></div>
          <div class="proof-pill"><strong>$1</strong><span>limited-time trial</span></div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="product-frame">
          <img src="/assets/dashboard-hero.png" alt="Retainr client management dashboard" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Niche Offer Ladder -->
  <section class="audience-strip" aria-labelledby="niche-offer-ladder-title">
    <div class="container audience-shell">
      <div class="audience-copy">
        <span class="eyebrow">Built for {niche.name}</span>
        <h2 id="niche-offer-ladder-title">Turn your specialist work into a starter offer, core package, and recurring plan.</h2>
        <p>
          This page is a niche-specific revenue path. It routes {niche.name} into Retainr with the audience context attached, so signup, onboarding, delivery, and recurring revenue can match the service being sold.
        </p>
      </div>

      <div class="audience-stack" aria-label={`${niche.name} offer ladder`}>
        {offerLadder.map((offer, index) => (
          <a href={nicheSignupUrl} class="audience-pill">
            <strong>{`Package ${index + 1}`}</strong>
            <span>{offer}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The Retainr Method -->
  <section id="method" class="section">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">The Retainr Method</span>
        <h2>A clear 6-step system to turn your skills into predictable revenue.</h2>
        <p>Stop chasing one-off projects. Use this repeatable method to package, sell, deliver, and retain clients inside one branded platform.</p>
      </div>

      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-icon">1</div>
          <h3>Package Your Expertise</h3>
          <p>Turn what you already do into clear, buyable offers clients can understand in seconds.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">2</div>
          <h3>Publish & Sell Instantly</h3>
          <p>Launch branded offers, take payment upfront, and remove the awkward sales conversation.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">3</div>
          <h3>Automated Onboarding</h3>
          <p>Magic signup links + niche-specific intake questions so clients arrive ready to work.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">4</div>
          <h3>Deliver in Your Brand Portal</h3>
          <p>Give clients a professional white-label experience that builds trust and reduces admin.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">5</div>
          <h3>Convert to Recurring</h3>
          <p>Turn successful one-time deliveries into natural monthly retainers.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">6</div>
          <h3>Stabilize & Retain</h3>
          <p>Automatic billing, renewals, health dashboards, and churn prevention, all on autopilot.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section ice">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">Audience Context</span>
        <h2>Each niche page routes creators to Retainr signup with audience context attached.</h2>
        <p>
          The signup button carries the niche parameter into Retainr, so the onboarding journey can match the audience, offer type, and client information required for {niche.name}.
        </p>
      </div>
      <NicheSignupVisual niche={niche} signupHref={nicheSignupUrl} />
    </div>
  </section>

  <!-- Niche Section -->
  <section class="section dark">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">The Method by Niche</span>
        <h2>Explore {relatedNicheCount} related creator workflows.</h2>
        <p>Retainr supports {nicheCount} dedicated niche workflows. These related paths show how the same method adapts to nearby expert-led creator businesses.</p>
      </div>

      <div class="niche-grid related-niche-grid">
        {relatedNiches.map((relatedNiche) => (
          <a class="niche-card" href={`/niches/${relatedNiche.slug}/`}>
            <div class="niche-header">
              <NicheIcon niche={relatedNiche} />
              <h3>{relatedNiche.name}</h3>
            </div>
            <p class="niche-desc">{relatedNiche.tagline}</p>
            <span class="button ghost niche-cta">See how it works →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Trial confidence band -->
  <GuaranteeBand 
    title={`Test the ${niche.name} workflow with one real offer.`}
    subtitle="Use the current $1 trial to check the buying, onboarding, and delivery experience before moving more client work into Retainr."
  />

  <Testimonials />
  <CtaBand
    title={`Build your ${niche.name} retainer engine`}
    text="Use the Retainr Method to package the first offer, onboard clients cleanly, deliver in one branded portal, and convert one-time wins into recurring revenue."
    cta={finalCtaText}
    href={nicheSignupUrl}
  />
</BaseLayout>
