---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import LegacyRedirect from "@/components/LegacyRedirect.astro";
import ShareBar from "@/components/ShareBar.astro";
import SkillsGuideCard from "@/components/SkillsGuideCard.astro";
import { assetDimensions } from "@/data/assets";
import { blogArticles, primaryBlogArticles } from "@/data/blog";
import { signupUrl } from "@/data/site";

export function getStaticPaths() {
  return blogArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const related = primaryBlogArticles
  .filter((item) => item.category === article.category && item.canonicalSlug !== article.canonicalSlug)
  .slice(0, 3);
const canonicalPath = `/blog/${article.canonicalSlug}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? "https://www.retainr.io").toString();
const articleImageDimensions = assetDimensions(article.image);
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description: article.description,
  image: new URL(article.image, Astro.site ?? "https://www.retainr.io").toString(),
  dateModified: article.updatedAt,
  mainEntityOfPage: canonicalUrl,
  inLanguage: "en",
  keywords: [article.category, article.audience, "freelancer client management", "recurring revenue"],
  isPartOf: {
    "@type": "Blog",
    name: "Retainr Blog",
    url: "https://www.retainr.io/blog/",
  },
  author: {
    "@id": "https://www.retainr.io/#pierre-henry",
  },
  publisher: { "@id": "https://www.retainr.io/#pierre-henry" },
  about: article.category,
};
---

{article.legacy ? (
  <LegacyRedirect title={article.title} destination={canonicalPath} />
) : (
<BaseLayout title={article.title} description={article.description} path={canonicalPath} image={article.image} type="article">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <article>
    <section class="hero marketing-hero blog-article-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">{article.category}</span>
          <h1>{article.title}</h1>
          <p>{article.description}</p>
          <div class="hero-actions">
            <a href={signupUrl} class="button">Start free forever</a>
            <a href="/income/" class="button ghost">Turn Expertise Into Revenue</a>
          </div>
          <div class="muted">Reviewed {article.updatedAt} for Retainr. Written for {article.audience} and niche freelancers.</div>
        </div>
        <div class="blog-insight-panel">
          <img
            class="article-hero-image"
            src={article.image}
            alt={article.imageAlt}
            width={articleImageDimensions.width}
            height={articleImageDimensions.height}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <div class="blog-insight-copy">
            <span class="trial">Practical Retainr guide</span>
            <h2>Turn useful advice into a client journey that continues.</h2>
            <p>
              Use this guide to shape a clear first offer, collect the right context, deliver a visible result, and introduce the next recurring plan.
            </p>
            <div class="blog-path" aria-label="Retainr blog conversion path">
              <span>Reader</span>
              <span>Offer</span>
              <span>Portal</span>
              <span>Retainer</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container article-layout">
        <div class="article-body">
          {article.sections.map((section) => (
            <section class="page-section">
              <h2>{section.title}</h2>
              <p>{section.body}</p>
              <ul class="check-list">
                {section.points.map((point) => <li>{point}</li>)}
              </ul>
            </section>
          ))}
          {article.sources.length > 0 && (
            <section class="page-section article-sources">
              <span class="eyebrow">Primary sources</span>
              <h2>References used in this guide</h2>
              <p>These sources support claims that may change over time. The practical recommendations and operating framework are Retainr's editorial synthesis.</p>
              <ul>
                {article.sources.map((source) => (
                  <li><a href={source.url} rel="noopener" target="_blank">{source.label}</a></li>
                ))}
              </ul>
            </section>
          )}
          <ShareBar
            title={article.title}
            description={article.description}
            path={canonicalPath}
            surface="blog-article"
          />
        </div>
        <aside class="article-sidebar">
          <SkillsGuideCard variant="sidebar" />
          <div class="page-section">
            <h2>Build the system</h2>
            <p>Use these Retainr pages to move from article advice to a working revenue workflow.</p>
            <div class="article-link-list">
              <a href="/method/">The Retainr Method</a>
              <a href="/features/">Retainr Features</a>
              <a href="/case-studies/">Freelancer Use Cases</a>
              <a href="/niches/designers/">Brand &amp; Web Designers</a>
              <a href="/niches/seo-experts/">SEO Experts &amp; Growth Marketers</a>
              <a href="/niches/ai-experts/">AI Consultants &amp; Automation Specialists</a>
              <a href="/niches/cartoonists/">Illustrators, Cartoonists &amp; Visual Creators</a>
              <a href="/niches/crypto-experts/">Crypto Experts &amp; Web3 Educators</a>
            </div>
          </div>
          <div class="page-section">
            <h2>Related reading</h2>
            <div class="article-link-list">
              {related.map((item) => <a href={`/blog/${item.slug}/`}>{item.title}</a>)}
            </div>
          </div>
        </aside>
      </div>
    </section>
  </article>

  <CtaBand title="Turn existing clients into recurring revenue" text="Package your repeated expertise into monthly offers, sell them with Retainr, and manage delivery from one branded client portal." />
</BaseLayout>
)}
