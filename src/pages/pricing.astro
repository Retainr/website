---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import Testimonials from "@/components/Testimonials.astro";
import pricing from "@/config/pricing.json";
import { signupUrl } from "@/data/site";
---

<BaseLayout
  title="Retainr Pricing for Niche Creators and Productized Service Experts"
  description="Choose a Retainr plan for selling niche services, onboarding clients, managing delivery, and turning trusted expertise into recurring revenue."
  path="/pricing/"
>
  <section class="hero center pricing-hero">
    <div class="container">
      <div class="hero-copy" style="justify-items:center">
        <span class="eyebrow">Pricing for Creator Revenue Systems</span>
        <h1 class="hero-title">Choose the plan that turns expertise into recurring client revenue.</h1>
        <p>Start with the clients who already trust your work. Package what they need next, deliver it through your brand, and grow into predictable monthly revenue.</p>
      </div>
    </div>
  </section>

  <section class="section pricing-section">
    <div class="container">
      <div class="pricing-toolbar">
        <div>
          <strong>Simple plans. Zero transaction fees.</strong>
          <span>Switch billing anytime as your client base grows.</span>
        </div>
        <div class="pricing-toggle" aria-label="Billing period">
          <button type="button" class="active" data-billing="monthly">{pricing.billing.monthlyLabel}</button>
          <button type="button" data-billing="yearly">{pricing.billing.yearlyLabel}</button>
        </div>
      </div>
      <div class="pricing-grid">
        {pricing.plans.map((plan) => (
          <article class:list={["pricing-card", { highlight: plan.highlight }]}>
            <div class="trial">{pricing.trialLabel}</div>
            <h3>{plan.name}</h3>
            <p class="muted">{plan.description}</p>
            <div class="price">
              <span>{pricing.currency}</span>
              <span data-monthly={plan.monthly} data-yearly={plan.yearly}>{plan.monthly}</span>
              <small>/month</small>
            </div>
            <a href={`${signupUrl}?plan=${plan.slug}`} class:list={["button", { yellow: plan.highlight }]}>{plan.cta}</a>
            <ul class="check-list">
              {plan.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {pricing.featuredFeature && (
    <section class="section prospection-section">
      <div class="container">
        <div class="prospection-layout">
          <article class="prospection-copy">
            <span class="eyebrow">{pricing.featuredFeature.name}</span>
            <h2>{pricing.featuredFeature.headline}</h2>
            <p>{pricing.featuredFeature.description}</p>
            <p>{pricing.featuredFeature.note}</p>
            <ul class="check-list">
              {pricing.featuredFeature.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
          <div class="prospection-visual" aria-label="Magic Prospections workflow">
            <span class="trial">{pricing.featuredFeature.eyebrow}</span>
            <div class="prospection-node"><strong>01</strong><span>Define your exact expertise and ideal buyer</span></div>
            <div class="prospection-node"><strong>02</strong><span>Find matched companies and relevant outreach angles</span></div>
            <div class="prospection-node"><strong>03</strong><span>Move warm replies into Retainr onboarding</span></div>
            <a href={`${signupUrl}?plan=magic-prospections`} class="button">Join Early Access</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section ice">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">Everything behind the method</span>
        <h2>Build the same branded buying and delivery system across every niche offer.</h2>
      </div>
      <div class="included-grid">
        {pricing.included.map((item) => (
          <div class="metric-card">
            <strong>{item}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">FAQ</span>
        <h2>Common pricing questions</h2>
      </div>
      <div class="faq-grid">
        {pricing.faq.map((item) => (
          <article class="faq-item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Start Selling Today" text="Create one niche offer, package the first paid outcome, start promoting the signup link, and manage delivery from a branded client portal." />
  <Testimonials />

  <script>
    const buttons = document.querySelectorAll("[data-billing]");
    const prices = document.querySelectorAll("[data-monthly][data-yearly]");
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const billing = button.getAttribute("data-billing") || "monthly";
        buttons.forEach((item) => item.classList.toggle("active", item === button));
        prices.forEach((price) => {
          const next = price.getAttribute(`data-${billing}`);
          if (next) price.textContent = next;
        });
      });
    });
  </script>
</BaseLayout>
