---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import Testimonials from "@/components/Testimonials.astro";
import pricing from "@/config/pricing.json";
import { signupUrl } from "@/data/site";

const pricedPlans = pricing.plans.map((plan) => ({
  ...plan,
  yearlySavings: (plan.monthly - plan.yearly) * 12,
  yearlyTotal: plan.yearly * 12,
}));
---

<BaseLayout
  title="Retainr Pricing for Niche Freelancers and Independent Experts"
  description="Choose a Retainr plan for selling niche services, onboarding clients, managing delivery, and turning trusted freelance expertise into recurring revenue."
  path="/pricing/"
>
  <section class="hero center pricing-hero">
    <div class="container">
      <div class="hero-copy" style="justify-items:center">
        <span class="eyebrow">Pricing for Independent Client Businesses</span>
        <h1 class="hero-title">Choose the plan that turns expertise into recurring client revenue.</h1>
        <p>Start with the clients who already trust your work. Package what they need next, deliver it through your brand, and grow into predictable monthly revenue.</p>
      </div>
    </div>
  </section>

  <section class="section pricing-section">
    <div class="container">
      <div class="pricing-toolbar">
        <div>
          <strong>Simple plans. Zero transaction fees.</strong>
          <span>Compare monthly and yearly pricing before you begin signup.</span>
        </div>
        <div class="pricing-toggle" aria-label="Billing period">
          <button type="button" class="active" data-billing="monthly" aria-pressed="true">{pricing.billing.monthlyLabel}</button>
          <button type="button" data-billing="yearly" aria-pressed="false">{pricing.billing.yearlyLabel} <span>Save up to $240</span></button>
        </div>
      </div>
      <div class="pricing-grid">
        {pricedPlans.map((plan) => (
          <article class:list={["pricing-card", { highlight: plan.highlight }]} data-plan-card={plan.slug}>
            <div class="trial">{plan.badge}</div>
            <h3>{plan.name}</h3>
            <p class="muted">{plan.description}</p>
            <div class="price">
              <span>{pricing.currency}</span>
              <span data-monthly={plan.monthly} data-yearly={plan.yearly}>{plan.monthly}</span>
              <small>/month</small>
            </div>
            <p
              class="price-detail"
              data-price-detail
              data-monthly-detail="Billed monthly"
              data-yearly-detail={`${pricing.currency}${plan.yearlyTotal} billed yearly`}
            >Billed monthly</p>
            <p class="price-saving" data-price-saving hidden>{`Save ${pricing.currency}${plan.yearlySavings} each year`}</p>
            <a
              href={`${signupUrl}?plan=${plan.slug}&billing=monthly`}
              data-plan-cta
              data-signup-base={`${signupUrl}?plan=${plan.slug}`}
              class:list={["button", { yellow: plan.highlight }]}
            >{plan.cta}</a>
            <ul class="check-list">
              {plan.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {pricing.featuredFeature && (
    <section class="section prospection-section">
      <div class="container">
        <div class="prospection-layout">
          <article class="prospection-copy">
            <span class="eyebrow">{pricing.featuredFeature.name}</span>
            <h2>{pricing.featuredFeature.headline}</h2>
            <p>{pricing.featuredFeature.description}</p>
            <p>{pricing.featuredFeature.note}</p>
            <ul class="check-list">
              {pricing.featuredFeature.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
          <div class="prospection-visual" aria-label="Magic Prospections workflow">
            <span class="trial">{pricing.featuredFeature.eyebrow}</span>
            <div class="prospection-node"><strong>01</strong><span>Define your exact expertise and ideal buyer</span></div>
            <div class="prospection-node"><strong>02</strong><span>Find matched companies and relevant outreach angles</span></div>
            <div class="prospection-node"><strong>03</strong><span>Move warm replies into Retainr onboarding</span></div>
            <a href={`${signupUrl}?plan=magic-prospections&intent=early-access`} class="button">Join Early Access</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section ice">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">Everything behind the method</span>
        <h2>Build the same branded buying and delivery system across every niche offer.</h2>
      </div>
      <div class="included-grid">
        {pricing.included.map((item) => (
          <div class="metric-card">
            <strong>{item}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">FAQ</span>
        <h2>Common pricing questions</h2>
      </div>
      <div class="faq-grid">
        {pricing.faq.map((item) => (
          <article class="faq-item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />
  <CtaBand
    title="Start with one offer and one client journey"
    text="Use the $1 trial to package the first paid outcome, inspect your signup flow, and manage delivery from a branded client portal."
    href={`${signupUrl}?plan=solo-creator&billing=monthly`}
  />

  <script>
    const buttons = document.querySelectorAll("[data-billing]");
    const prices = document.querySelectorAll("[data-monthly][data-yearly]");
    const details = document.querySelectorAll<HTMLElement>("[data-price-detail]");
    const savings = document.querySelectorAll<HTMLElement>("[data-price-saving]");
    const planCtas = document.querySelectorAll<HTMLAnchorElement>("[data-plan-cta]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const billing = button.getAttribute("data-billing") || "monthly";
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle("active", active);
          item.setAttribute("aria-pressed", String(active));
        });
        prices.forEach((price) => {
          const next = price.getAttribute(`data-${billing}`);
          if (next) price.textContent = next;
        });
        details.forEach((detail) => {
          detail.textContent = detail.dataset[`${billing}Detail`] || "";
        });
        savings.forEach((saving) => {
          saving.hidden = billing !== "yearly";
        });
        planCtas.forEach((cta) => {
          const base = cta.dataset.signupBase;
          if (!base) return;
          const destination = new URL(base);
          destination.searchParams.set("billing", billing);
          cta.href = destination.toString();
        });
      });
    });
  </script>
</BaseLayout>
