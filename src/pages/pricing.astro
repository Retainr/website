---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import Testimonials from "@/components/Testimonials.astro";
import pricing from "@/config/pricing.json";
import { signupUrl } from "@/data/site";

const pricingFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pricing.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="Retainr Pricing: Free Forever for Independent Experts"
  description="Retainr is free forever, with every feature, unlimited team members and clients, white-label portals, and no Retainr transaction fees."
  path="/pricing/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(pricingFaqSchema)}></script>

  <section class="hero center pricing-hero free-pricing-hero">
    <div class="container">
      <div class="hero-copy" style="justify-items:center">
        <span class="eyebrow">Retainr is now free forever</span>
        <h1 class="hero-title">No plans. No seat fees. No feature limits.</h1>
        <p>Build the complete branded client journey from your first offer to recurring revenue without choosing a tier.</p>
      </div>
    </div>
  </section>

  <section class="free-pricing-section" aria-labelledby="free-pricing-title">
    <div class="container free-pricing-stage">
      <div class="free-price" aria-label={`${pricing.currency}${pricing.price} forever`}>
        <span>{pricing.currency}</span>
        <strong>{pricing.price}</strong>
        <small>forever</small>
      </div>
      <div class="free-pricing-copy">
        <span>{pricing.badge}</span>
        <h2 id="free-pricing-title">{pricing.headline}</h2>
        <p>{pricing.description}</p>
        <a href={signupUrl} class="button">{pricing.cta}</a>
      </div>
      <ul class="free-pricing-proof" aria-label="Free Retainr access includes">
        <li><strong>Every feature</strong><span>White label, portals, delivery, support, API, and mobile access</span></li>
        <li><strong>Unlimited people</strong><span>Invite the team and clients your work actually needs</span></li>
        <li><strong>0% platform fee</strong><span>Retainr does not take a percentage of client payments</span></li>
      </ul>
    </div>
  </section>

  {pricing.featuredFeature && (
    <section class="section prospection-section">
      <div class="container">
        <div class="prospection-layout">
          <article class="prospection-copy">
            <span class="eyebrow">{pricing.featuredFeature.name}</span>
            <h2>{pricing.featuredFeature.headline}</h2>
            <p>{pricing.featuredFeature.description}</p>
            <p>{pricing.featuredFeature.note}</p>
            <ul class="check-list">
              {pricing.featuredFeature.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
          <div class="prospection-visual" aria-label="Magic Prospections workflow">
            <span class="trial">{pricing.featuredFeature.eyebrow}</span>
            <div class="prospection-node"><strong>01</strong><span>Define your exact expertise and ideal buyer</span></div>
            <div class="prospection-node"><strong>02</strong><span>Find matched companies and relevant outreach angles</span></div>
            <div class="prospection-node"><strong>03</strong><span>Move warm replies into Retainr onboarding</span></div>
            <a href={`${signupUrl}?intent=magic-prospections`} class="button">Create a free workspace</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section ice">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">The complete client system</span>
        <h2>Everything behind the Retainr Method is included.</h2>
      </div>
      <div class="included-grid">
        {pricing.included.map((item) => (
          <div class="metric-card"><strong>{item}</strong></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">FAQ</span>
        <h2>Free-forever questions, answered clearly.</h2>
      </div>
      <div class="faq-grid">
        {pricing.faq.map((item) => (
          <article class="faq-item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />
  <CtaBand
    title="Start with one offer and keep every capability"
    text="Create your free workspace, publish the first paid outcome, and manage delivery from a branded client portal."
  />
</BaseLayout>
