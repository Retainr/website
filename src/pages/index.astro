---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import Testimonials from "@/components/Testimonials.astro";
import GuaranteeBand from "@/components/GuaranteeBand.astro";
import MethodSteps from "@/components/MethodSteps.astro";
import WorkdayRelief from "@/components/WorkdayRelief.astro";
import NicheIcon from "@/components/NicheIcon.astro";
import { signupUrl } from "@/data/site";
import { featuredNiches, niches } from "@/data/niches";

const nicheCount = niches.length;
const homepageNiches = featuredNiches.slice(0, 4);
const homepageNicheCount = homepageNiches.length;

const audienceSegments = [
  { label: "AI consultants", href: "/niches/ai-experts/", offer: "AI audits to optimization retainers" },
  { label: "SEO experts", href: "/niches/seo-experts/", offer: "Search audits to monthly growth plans" },
  { label: "Designers", href: "/niches/designers/", offer: "Brand sprints to creative desks" },
  { label: "Coaches", href: "/niches/digital-coaches/", offer: "Programs to accountability retainers" },
  { label: "Info creators", href: "/niches/info-products/", offer: "Courses to implementation support" },
  { label: "Wellness experts", href: "/niches/nutritionists/", offer: "Plans to recurring care" },
];

const operatingModules = [
  {
    label: "Unified Dashboard",
    title: "Manage every client from one command center",
    body: "Track orders, tasks, files, tickets, invoices, approvals, and delivery status without stitching together five tools.",
  },
  {
    label: "White Label Portal",
    title: "A client experience under your brand",
    body: "Clients buy, onboard, upload context, request support, and follow progress inside a professional portal that keeps your expert brand visible.",
  },
  {
    label: "Automation",
    title: "Workflows that keep momentum moving",
    body: "Use intake, magic links, support routing, Zapier, webhooks, and repeatable delivery steps to reduce manual admin after every sale.",
  },
  {
    label: "Recurring Revenue",
    title: "Turn one-time wins into retainers",
    body: "Package starter offers, core services, and ongoing plans so existing clients have a natural path to continue with you.",
  },
];

const workdayChallenges = [
  "A client says yes, then waits while you rebuild the proposal, invoice, intake form, and project board by hand.",
  "Project context is split across email, DMs, payment links, folders, and task tools, so every update begins with a search.",
  "A completed project goes quiet because the next useful service was never made visible or easy to buy.",
];

const workdayOutcomes = [
  "Send one package link that carries the scope, payment, and onboarding into the right client workflow.",
  "Keep the client, order, files, requests, decisions, and delivery status connected inside your branded portal.",
  "Present the relevant support or optimization plan while the result, context, and relationship are still active.",
];
---

<BaseLayout
  title="Retainr: Turn Client Work Into Recurring Revenue"
  description="Retainr helps niche freelancers package services, onboard clients, deliver in one branded portal, and turn successful work into recurring revenue."
  path="/"
>
  <section class="home-intro" aria-labelledby="home-title">
    <div class="container home-intro-shell">
      <div class="home-intro-copy">
        <span class="home-kicker"><i></i> The client revenue system for independent experts</span>
        <h1 id="home-title"><span>Retainr</span> turns client work into <mark>recurring revenue.</mark></h1>
        <p>
          Package what you do, send one buying link, onboard clients, deliver under your brand, and
          make the next useful service easy to continue. One system from first yes to lasting revenue.
        </p>
        <div class="hero-actions home-intro-actions">
          <a href={signupUrl} class="button">Start free forever</a>
          <a href="#method" class="button ghost">See the Retainr Method</a>
        </div>
        <p class="home-access-note"><strong>$0 forever.</strong> No plans, seat fees, or feature limits.</p>
      </div>

      <div class="home-product-stage" aria-label="Retainr product experience">
        <div class="home-stage-mark home-stage-mark-left" aria-hidden="true"></div>
        <div class="home-product-window">
          <div class="home-product-bar">
            <span aria-hidden="true"></span>
            <strong>app.retainr.io</strong>
            <small>Your client business, in one place</small>
          </div>
          <img src="/assets/dashboard-hero.png" alt="Retainr dashboard showing team, tasks, clients, and revenue" loading="eager" width="1600" height="682" />
        </div>
        <div class="home-stage-note home-stage-note-link">
          <span>01</span><strong>Sell with one link</strong><small>Offer → payment → onboarding</small>
        </div>
        <div class="home-stage-note home-stage-note-method">
          <span>THE METHOD</span><strong>Package → Sell → Deliver → Retain</strong>
        </div>
        <div class="home-stage-note home-stage-note-free">
          <strong>FREE</strong><span>Every feature. Forever.</span>
        </div>
      </div>

      <div class="home-proof-line" aria-label="Retainr product facts">
        <span><strong>0%</strong> Retainr transaction fees</span>
        <span><strong>100%</strong> white-label client experience</span>
        <span><strong>Unlimited</strong> team members and clients</span>
      </div>
    </div>
  </section>

  <!-- Audience Positioning -->
  <section class="specialist-index" aria-labelledby="audience-strip-title">
    <div class="container specialist-index-shell">
      <div class="specialist-index-copy">
        <span>Built for people clients trust</span>
        <h2 id="audience-strip-title">Your expertise is specific. Your client system should be too.</h2>
        <p>Retainr turns specialist knowledge into a clear offer, a professional delivery experience, and a natural path to recurring work.</p>
        <a href="/niches/" class="text-link">Explore every specialist playbook →</a>
      </div>
      <div class="specialist-index-list" aria-label="Specialist audiences Retainr serves">
        {audienceSegments.map((segment, index) => (
          <a href={segment.href}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{segment.label}</strong>
            <small>{segment.offer}</small>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Retainr Product Showcase -->
  <section class="retainr-showcase" aria-labelledby="retainr-showcase-title">
    <div class="container showcase-shell">
      <div class="showcase-heading">
        <span class="eyebrow">Retainr in Action</span>
        <h2 id="retainr-showcase-title">Productize the service, send the link, get paid, deliver from one dashboard.</h2>
      </div>

      <div class="showcase-grid">
        <article class="showcase-card showcase-card-large">
          <div class="showcase-copy">
            <span class="trial">Every feature - free forever</span>
            <h3>Offer Custom Packages</h3>
            <p>Build fixed-fee subscriptions, retainers, one-off jobs, and paid trials that are clear enough for clients to buy without another proposal thread.</p>
          </div>
          <img src="/assets/packages.png" alt="Retainr packages dashboard" loading="lazy" width="1080" height="1061" />
        </article>

        <article class="showcase-card">
          <img src="/assets/onboarding.png" alt="Retainr onboarding magic links" loading="lazy" width="1080" height="674" />
          <div class="showcase-copy">
            <h3>Lead-to-Client Made Simple</h3>
            <p>Use service-specific signup links from calls, emails, webinars, and niche pages so each buyer lands in the right onboarding flow.</p>
          </div>
        </article>

        <article class="showcase-card">
          <img src="/assets/revenue-graph.png" alt="Retainr revenue graph" loading="lazy" width="1080" height="564" />
          <div class="showcase-copy">
            <h3>Hassle-Free Payments</h3>
            <p>Connect packages, invoices, recurring payments, and project delivery so revenue is tied to the client workflow from the first click.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Retainr Operating System -->
  <section class="section operating-system-section" aria-labelledby="operating-system-title">
    <div class="container operating-system-grid">
      <div class="operating-system-copy">
        <span class="trial">Every feature - free forever</span>
        <span class="eyebrow">What Matters. Unified Dashboard.</span>
        <h2 id="operating-system-title">One Retainr workspace for selling, earning, and running your specialist business.</h2>
        <p>
          Replace disconnected checkout links, forms, inboxes, task boards, and file folders with one
          client journey that starts at the offer and continues through delivery, support, and renewal.
        </p>
        <div class="operating-system-proof" aria-label="Retainr operating system proof points">
          <strong>Sell. Earn. Automate.</strong>
          <span>Packages, payments, onboarding, support, delivery, referrals, and renewals in one place.</span>
        </div>
      </div>

      <div class="operating-system-visual" aria-label="Retainr product modules">
        <div class="operating-browser">
          <div class="operating-browser-bar">
            <span></span>
            <strong>retainr.io/client-portal</strong>
          </div>
          <img src="/assets/client-portal.webp" alt="Retainr white-label client portal interface" loading="lazy" width="898" height="372" />
        </div>

        <div class="operating-modules">
          {operatingModules.map((module) => (
            <article class="operating-module">
              <span>{module.label}</span>
              <h3>{module.title}</h3>
              <p>{module.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <WorkdayRelief
    audience="freelancers and independent experts"
    title="Give clients clarity without giving admin your day."
    intro="AI can speed up production, but it also raises client expectations. Retainr protects the value clients keep paying for: clear judgment, reliable delivery, and continuity."
    challenges={workdayChallenges}
    outcomes={workdayOutcomes}
    ctaHref="/method/"
    ctaLabel="See the complete method"
  />

  <MethodSteps />

  <!-- Niche Section -->
  <section class="section creator-niche-section">
    <div class="container">
      <div class="niche-showcase">
        <div class="niche-panel-copy">
          <span class="eyebrow">The Method by Niche</span>
          <h2>See the Retainr Method applied to {homepageNicheCount} specialist businesses.</h2>
          <p>Explore the clearest paths from a specialist first offer to a recurring client plan, then browse all {nicheCount} niche playbooks.</p>
          <div class="niche-routing-note">
            <strong>Magic signup context</strong>
            <span>Every niche page passes the audience into onboarding.</span>
          </div>
        </div>

        <div class="niche-grid">
          {homepageNiches.map((niche, index) => (
            <a class="niche-card" href={`/niches/${niche.slug}/`}>
              <span class="niche-index">0{index + 1}</span>
              <div class="niche-header">
                <NicheIcon niche={niche} />
                <h3>{niche.name}</h3>
              </div>
              <p class="niche-desc">{niche.tagline}</p>
              <span class="niche-route">Niche-aware onboarding</span>
              <span class="button ghost niche-cta">See how it works →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Free-forever confidence band -->
  <GuaranteeBand 
    title="Start with one offer. Keep the whole system."
    subtitle="Retainr is free forever. Publish a real package, inspect the client journey, and invite the people your delivery needs without choosing a plan."
  />

  <Testimonials />
  <CtaBand />
</BaseLayout>
