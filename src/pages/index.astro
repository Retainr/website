---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import Testimonials from "@/components/Testimonials.astro";
import GuaranteeBand from "@/components/GuaranteeBand.astro";
import { homeFeatures, productHighlights, signupUrl } from "@/data/site";
import { niches } from "@/data/niches";
---

<BaseLayout
  title="Retainr: The Retainr Method — Turn Your Skills Into Predictable Revenue"
  description="The Retainr Method: Package your expertise, sell with clarity, deliver professionally, and turn one-time clients into recurring revenue — all from one branded platform."
  path="/"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Built for Digital Creators & Niche Experts</span>
        <h1>Turn Your Expertise<br />Into a <span>Recurring Revenue Engine</span></h1>
        <p>
          The Retainr Method gives you a clear, repeatable system to package your skills, 
          sell with confidence, deliver professionally, and turn one-time clients into predictable monthly revenue.
        </p>
        <div class="hero-actions">
          <a href={signupUrl} class="button">Start Your Retainer Engine</a>
          <a href="#method" class="button ghost">See The Method</a>
        </div>
        <div class="hero-proof">
          <div class="proof-pill"><strong>0%</strong><span>transaction fees</span></div>
          <div class="proof-pill"><strong>100%</strong><span>white label</span></div>
          <div class="proof-pill"><strong>14-day</strong><span>risk-free trial</span></div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="product-frame">
          <img src="/assets/dashboard-hero.png" alt="Retainr client management dashboard" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Trusted Platform Badges -->
  <section class="brand-strip" aria-label="Trusted integrations and platforms">
    <div class="container">
      <div class="brand-grid">
        <div class="brand-badge"><span>Stripe</span></div>
        <div class="brand-badge"><span>PayPal</span></div>
        <div class="brand-badge"><span>Zapier</span></div>
        <div class="brand-badge"><span>AWS</span></div>
        <div class="brand-badge"><span>Analytics</span></div>
      </div>
    </div>
  </section>

  <!-- The Retainr Method -->
  <section id="method" class="section">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">The Retainr Method</span>
        <h2>A clear 6-step system to turn your skills into predictable revenue.</h2>
        <p>Stop chasing one-off projects. Use this repeatable method to package, sell, deliver, and retain clients — all inside one branded platform.</p>
      </div>

      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-icon">1</div>
          <h3>Package Your Expertise</h3>
          <p>Turn what you already do into clear, buyable offers clients can understand in seconds.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">2</div>
          <h3>Publish & Sell Instantly</h3>
          <p>Launch branded offers, take payment upfront, and remove the awkward sales conversation.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">3</div>
          <h3>Automated Onboarding</h3>
          <p>Magic signup links + niche-specific intake questions so clients arrive ready to work.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">4</div>
          <h3>Deliver in Your Brand Portal</h3>
          <p>Give clients a professional white-label experience that builds trust and reduces admin.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">5</div>
          <h3>Convert to Recurring</h3>
          <p>Turn successful one-time deliveries into natural monthly retainers.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">6</div>
          <h3>Stabilize & Retain</h3>
          <p>Automatic billing, renewals, health dashboards, and churn prevention — all on autopilot.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Niche Section -->
  <section class="section dark">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">The Method by Niche</span>
        <h2>Built for 6 specific types of digital creators.</h2>
        <p>Retainr works best when focused. See how the method applies to your exact niche.</p>
      </div>

      <div class="niche-grid">
        {niches.map((niche) => (
          <a class="niche-card" href={`/niches/${niche.slug}/`}>
            <div class="niche-header">
              <div class="niche-icon">{niche.icon}</div>
              <h3>{niche.name}</h3>
            </div>
            <p class="niche-desc">{niche.tagline}</p>
            <span class="button ghost niche-cta">See how it works →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Guarantee Band -->
  <GuaranteeBand 
    title="Risk-Free. Built for Results." 
    subtitle="We designed Retainr so you can test the full method with zero risk."
  />

  <Testimonials />
  <CtaBand />
</BaseLayout>