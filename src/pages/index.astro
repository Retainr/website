---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "@/components/CtaBand.astro";
import Testimonials from "@/components/Testimonials.astro";
import GuaranteeBand from "@/components/GuaranteeBand.astro";
import NicheIcon from "@/components/NicheIcon.astro";
import { signupUrl } from "@/data/site";
import { featuredNiches, niches } from "@/data/niches";

const nicheCount = niches.length;
const homepageNiches = featuredNiches.slice(0, 4);
const homepageNicheCount = homepageNiches.length;

const audienceSegments = [
  { label: "AI consultants", href: "/niches/ai-experts/", offer: "AI audits to optimization retainers" },
  { label: "SEO experts", href: "/niches/seo-experts/", offer: "Search audits to monthly growth plans" },
  { label: "Designers", href: "/niches/designers/", offer: "Brand sprints to creative desks" },
  { label: "Coaches", href: "/niches/digital-coaches/", offer: "Programs to accountability retainers" },
  { label: "Info creators", href: "/niches/info-products/", offer: "Courses to implementation support" },
  { label: "Wellness experts", href: "/niches/nutritionists/", offer: "Plans to recurring care" },
];
---

<BaseLayout
  title="Retainr: Turn Services Into Profitable Products"
  description="Retainr helps niche experts, digital creators, and expert-led service teams sell services in seconds, manage clients, collect payments, automate onboarding, and turn expertise into recurring revenue."
  path="/"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Client Management Platform Trusted by 1,000+ Creator-Led Businesses</span>
        <h1>Turn Services Into <span>Profitable Products</span></h1>
        <h2 class="hero-subtitle">Sell. Earn. Automate.</h2>
        <p>
          Sell your services in seconds. Display your expertise to the world. Retainr gives creators
          one all-in-one system for client management, orders, payments, tasks, file storage, helpdesk,
          project delivery, referrals, and recurring revenue.
        </p>
        <div class="hero-actions">
          <a href={signupUrl} class="button">Start Selling Today with $1</a>
          <a href="#method" class="button ghost">See The Method</a>
        </div>
        <div class="hero-proof">
          <div class="proof-pill"><strong>0%</strong><span>transaction fees</span></div>
          <div class="proof-pill"><strong>100%</strong><span>white label</span></div>
          <div class="proof-pill"><strong>14-day</strong><span>risk-free trial</span></div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="product-frame">
          <img src="/assets/dashboard-hero.png" alt="Retainr client management dashboard" loading="eager" />
        </div>
        <div class="hero-ticket hero-ticket-top">
          <strong>Magic Link</strong>
          <span>Client joins the right plan in one click</span>
        </div>
        <div class="hero-ticket hero-ticket-bottom">
          <strong>Limited Time - $1 Trial</strong>
          <span>Start selling services today</span>
        </div>
        <div class="hero-system-card">
          <span>Retainr Method</span>
          <strong>Package → Pay → Onboard → Retain</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- Audience Positioning -->
  <section class="audience-strip" aria-labelledby="audience-strip-title">
    <div class="container audience-shell">
      <div class="audience-copy">
        <span class="eyebrow">Built for Niche Creators</span>
        <h2 id="audience-strip-title">Not another client database. Retainr is the storefront, onboarding path, and client portal for experts who sell outcomes.</h2>
        <p>
          The best Retainr customers already have expertise people trust. The missing piece is a branded system that turns that expertise into packages, paid signup links, delivery workflows, and recurring offers.
        </p>
      </div>

      <div class="audience-stack" aria-label="Creator audiences Retainr serves">
        {audienceSegments.map((segment) => (
          <a href={segment.href} class="audience-pill">
            <strong>{segment.label}</strong>
            <span>{segment.offer}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Retainr Product Showcase -->
  <section class="retainr-showcase" aria-labelledby="retainr-showcase-title">
    <div class="container showcase-shell">
      <div class="showcase-heading">
        <span class="eyebrow">Retainr in Action</span>
        <h2 id="retainr-showcase-title">Productize the service, send the link, get paid, deliver from one dashboard.</h2>
      </div>

      <div class="showcase-grid">
        <article class="showcase-card showcase-card-large">
          <div class="showcase-copy">
            <span class="trial">Limited Time - $1 Trial</span>
            <h3>Offer Custom Packages</h3>
            <p>Build fixed-fee subscriptions, retainers, one-off jobs, and paid trials that are clear enough for clients to buy without another proposal thread.</p>
          </div>
          <img src="/assets/packages.png" alt="Retainr packages dashboard" loading="lazy" />
        </article>

        <article class="showcase-card">
          <img src="/assets/onboarding.png" alt="Retainr onboarding magic links" loading="lazy" />
          <div class="showcase-copy">
            <h3>Lead-to-Client Made Simple</h3>
            <p>Use service-specific signup links from calls, emails, webinars, and niche pages so each buyer lands in the right onboarding flow.</p>
          </div>
        </article>

        <article class="showcase-card">
          <img src="/assets/revenue-graph.png" alt="Retainr revenue graph" loading="lazy" />
          <div class="showcase-copy">
            <h3>Hassle-Free Payments</h3>
            <p>Connect packages, invoices, recurring payments, and project delivery so revenue is tied to the client workflow from the first click.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- The Retainr Method -->
  <section id="method" class="section method-section">
    <div class="container">
      <div class="section-heading centered">
        <span class="eyebrow">Turn What You Do Into Profitable Products</span>
        <h2>A clear 6-step system to package, sell, deliver, and retain clients.</h2>
        <p>Keep the original Retainr promise, then make it sharper for niche creators: one place to productize your expertise, onboard clients, automate delivery, and convert good work into predictable monthly revenue.</p>
      </div>

      <div class="feature-grid method-grid">
        <article class="feature-card method-card">
          <div class="feature-icon">1</div>
          <h3>Package Your Expertise</h3>
          <p>Turn what you already do into clear, buyable offers clients can understand in seconds.</p>
        </article>
        <article class="feature-card method-card">
          <div class="feature-icon">2</div>
          <h3>Publish & Sell Instantly</h3>
          <p>Launch branded offers, take payment upfront, and remove the awkward sales conversation.</p>
        </article>
        <article class="feature-card method-card">
          <div class="feature-icon">3</div>
          <h3>Automated Onboarding</h3>
          <p>Magic signup links + niche-specific intake questions so clients arrive ready to work.</p>
        </article>
        <article class="feature-card method-card">
          <div class="feature-icon">4</div>
          <h3>Deliver in Your Brand Portal</h3>
          <p>Give clients a professional white-label experience that builds trust and reduces admin.</p>
        </article>
        <article class="feature-card method-card">
          <div class="feature-icon">5</div>
          <h3>Convert to Recurring</h3>
          <p>Turn successful one-time deliveries into natural monthly retainers.</p>
        </article>
        <article class="feature-card method-card">
          <div class="feature-icon">6</div>
          <h3>Stabilize & Retain</h3>
          <p>Automatic billing, renewals, health dashboards, and churn prevention, all on autopilot.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Niche Section -->
  <section class="section creator-niche-section">
    <div class="container">
      <div class="niche-showcase">
        <div class="niche-panel-copy">
          <span class="eyebrow">The Method by Niche</span>
          <h2>Start with {homepageNicheCount} high-intent creator paths.</h2>
          <p>Retainr supports {nicheCount} dedicated niche workflows. This first view stays focused on the creator categories with the clearest path from expertise to recurring revenue.</p>
          <div class="niche-routing-note">
            <strong>Magic signup context</strong>
            <span>Every niche page passes the audience into onboarding.</span>
          </div>
        </div>

        <div class="niche-grid">
          {homepageNiches.map((niche, index) => (
            <a class="niche-card" href={`/niches/${niche.slug}/`}>
              <span class="niche-index">0{index + 1}</span>
              <div class="niche-header">
                <NicheIcon niche={niche} />
                <h3>{niche.name}</h3>
              </div>
              <p class="niche-desc">{niche.tagline}</p>
              <span class="niche-route">signup?niche={niche.slug}</span>
              <span class="button ghost niche-cta">See how it works →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Guarantee Band -->
  <GuaranteeBand 
    title="Risk-Free. Built for Results." 
    subtitle="We designed Retainr so you can test the full method with zero risk."
  />

  <Testimonials />
  <CtaBand />
</BaseLayout>
