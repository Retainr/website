---
import { assetDimensions } from "@/data/assets";
import { skillsGuide } from "@/data/site";

type Props = {
  variant?: "featured" | "sidebar";
};

const { variant = "featured" } = Astro.props;
const coverDimensions = assetDimensions(skillsGuide.coverPath);
---

<aside class:list={["skills-guide-card", `skills-guide-card-${variant}`]} aria-labelledby={`skills-guide-${variant}-title`}>
  <a class="skills-guide-cover" href={skillsGuide.landingPath} aria-label={`Explore ${skillsGuide.title}`}>
    <img
      src={skillsGuide.coverPath}
      alt="Cover of Retainr's high-demand freelance skills workbook"
      width={coverDimensions.width}
      height={coverDimensions.height}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="skills-guide-copy">
    <span class="eyebrow">Free freelancer workbook</span>
    <h2 id={`skills-guide-${variant}-title`}>{skillsGuide.title}</h2>
    <p>{skillsGuide.description}</p>
    <ul aria-label="Workbook highlights">
      <li>12 skill tracks</li>
      <li>Offer scorecard</li>
      <li>7-day validation sprint</li>
      <li>30-day action plan</li>
    </ul>
    <div class="skills-guide-actions">
      <a class="button" href={skillsGuide.landingPath}>Explore the workbook</a>
      <a class="text-link" href={skillsGuide.pdfPath} download>Download PDF <span aria-hidden="true">↓</span></a>
    </div>
    <small>No email required. Keep it, print it, or use the offer canvas on page 11.</small>
  </div>
</aside>
