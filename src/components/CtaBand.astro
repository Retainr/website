---
import { signupUrl } from "@/data/site";

const { title = "Build a client business that does not depend on your inbox", text = "Retainr helps niche freelancers and independent experts turn services into buyable offers, guided delivery, and recurring client revenue from one branded place.", cta = "Start Your $1 Trial", href = signupUrl } = Astro.props;
---

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a href={href} class="button secondary">{cta}</a>
  </div>
</section>
