---
import { signupUrl } from "@/data/site";

const { title = "Turn Expertise Into Income", text = "Retainr helps niche experts turn services into buyable products, paid signup links, branded portals, and recurring client revenue from one place.", cta = "Start Selling Today", href = signupUrl } = Astro.props;
---

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a href={href} class="button secondary">{cta}</a>
  </div>
</section>
