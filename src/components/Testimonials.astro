---
import { testimonials } from "@/data/site";
---

<section class="section customer-evidence" aria-labelledby="customer-evidence-title">
  <div class="container">
    <div class="customer-evidence-heading">
      <div>
        <span class="eyebrow">Customer-Reported Outcomes</span>
        <h2 id="customer-evidence-title">What becomes easier when the client journey lives in one place</h2>
      </div>
      <p>Real client-operation outcomes, summarized without inflated performance claims.</p>
    </div>
    <div class="customer-evidence-grid">
      {testimonials.map((item) => (
        <article class="customer-evidence-item">
          <div class="customer-evidence-person">
            <span aria-hidden="true">{item.name.charAt(0)}</span>
            <div>
              <strong>{item.name}</strong>
              <small>{item.role}</small>
            </div>
          </div>
          <span class="customer-evidence-label">Reported outcome</span>
          <h3>{item.outcome}</h3>
          <p>{item.quote}</p>
        </article>
      ))}
    </div>
  </div>
</section>
