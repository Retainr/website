---
import type { MarketingPage } from "@/data/pages";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "./CtaBand.astro";
import Testimonials from "./Testimonials.astro";
import { signupUrl } from "@/data/site";

type Props = { page: MarketingPage };
const { page } = Astro.props;
const path = `/${page.slug}/`;
const methodSteps = ["Package", "Sell", "Onboard", "Deliver", "Retain"];
---

<BaseLayout title={page.title} description={page.description} path={path}>
  <!-- Hero -->
  <section class="hero marketing-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{page.eyebrow ?? "Retainr"}</span>
        <h1>{page.hero}</h1>
        <p>{page.subhero}</p>
        <div class="hero-actions">
          <a href={signupUrl} class="button">Start Selling Today</a>
          <a href="/pricing/" class="button ghost">View Pricing</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="product-frame">
          <img src={page.image ?? "/assets/dashboard-hero.png"} alt={`${page.hero} in Retainr`} loading="eager" />
        </div>
        <div class="hero-ticket hero-ticket-top">
          <strong>Magic Link</strong>
          <span>Send this offer into the right signup flow</span>
        </div>
        <div class="hero-ticket hero-ticket-bottom">
          <strong>White Label</strong>
          <span>Keep the creator brand at the center</span>
        </div>
      </div>
    </div>
  </section>

  <section class="page-method-band" aria-label="Retainr method steps">
    <div class="container page-method-shell">
      <span class="page-method-label">Retainr Method</span>
      <div class="page-method-steps">
        {methodSteps.map((step, index) => (
          <span>
            <strong>{String(index + 1).padStart(2, "0")}</strong>
            {step}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Special Section: Brand Assets -->
  {page.slug === "brand-assets" && (
    <section class="section ice">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Color palette</span>
          <h2>Same Retainr colors, cleaner system</h2>
        </div>
        <div class="swatch-grid">
          {["#FF4D18", "#FFD540", "#FFFFFF", "#1d2130", "#EDF8FD", "#B7CD4B"].map((hex) => (
            <div class="swatch">
              <div class="swatch-color" style={`background:${hex}`}></div>
              <div class="swatch-label">{hex}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Dynamic Page Sections -->
  <section class="section">
    <div class="container page-grid">
      {page.sections.map((section) => (
        <article class="page-section">
          <span class="eyebrow">Retainr</span>
          <h2>{section.title}</h2>
          <p>{section.body}</p>
          {section.points && (
            <ul class="check-list">
              {section.points.map((point) => <li>{point}</li>)}
            </ul>
          )}
        </article>
      ))}

      <!-- Creator Revenue System -->
      <article class="page-section">
        <span class="eyebrow">Creator revenue system</span>
        <h2>How this page connects to recurring revenue</h2>
        <p>
          Retainr is built for digital creators and niche experts who already have trusted expertise but need a better system for selling it. The goal is not just to publish a page, collect a lead, or close one project. The goal is to turn a buyer into a client, a client into a repeat client, and repeat work into a clear recurring offer that can be managed without scattered tools.
        </p>
        <ul class="check-list">
          <li>Package the service into a specific offer clients can understand quickly</li>
          <li>Send buyers into a branded signup and onboarding flow</li>
          <li>Attach orders, files, tasks, tickets, approvals, and payment context to one client record</li>
          <li>Use the first delivery to introduce the next recurring plan</li>
        </ul>
      </article>

      <!-- Updated Niche Examples -->
      <article class="page-section">
        <span class="eyebrow">Niche examples</span>
        <h2>Who can use this workflow?</h2>
        <p>
          This workflow is designed specifically for digital creators and niche service experts who want to turn their expertise into predictable monthly revenue. Each of these niches has a different service promise, but they all benefit from the same operating model: sell a clear package, collect the right client information, deliver through a professional portal, and create a reason to continue.
        </p>
        <ul class="check-list">
          <li><a href="/niches/ai-experts/">AI Consultants & Automation Specialists</a> can sell audits, implementation sprints, and monthly optimization retainers</li>
          <li><a href="/niches/seo-experts/">SEO Experts & Growth Marketers</a> can sell audits, content roadmaps, and monthly growth retainers</li>
          <li><a href="/niches/designers/">Brand & Web Designers</a> can sell brand sprints, landing pages, and monthly creative retainers</li>
          <li><a href="/niches/life-coaches/">Digital Life & Business Coaches</a> can sell transformation programs and monthly accountability retainers</li>
          <li><a href="/niches/info-products/">Info Product & Online Course Creators</a> can sell courses, templates, and monthly implementation coaching</li>
          <li><a href="/niches/cartoonists/">Illustrators, Cartoonists & Visual Creators</a> can sell character design packages and monthly visual content retainers</li>
          <li><a href="/niches/nutritionists/">Nutritionists & Wellness Creators</a> can sell structured programmes and recurring accountability</li>
          <li><a href="/niches/crypto-experts/">Crypto Experts & Web3 Educators</a> can sell education retainers with clearer boundaries</li>
          <li><a href="/niches/podcast-producers/">Podcast Producers & Audio Editors</a> can sell monthly production workflows</li>
        </ul>
      </article>

      <!-- Next Steps -->
      <article class="page-section">
        <span class="eyebrow">Next steps</span>
        <h2>Build the full Retainr path</h2>
        <p>
          A strong Retainr page should always lead somewhere useful. If a visitor is comparing tools, send them to pricing. If they are learning to package services, send them to productize. If they want to improve conversion, send them to sales funnels and client onboarding. This internal link structure makes Retainr the obvious platform for creators who want to turn existing clients into recurring revenue.
        </p>
        <ul class="check-list">
          <li><a href="/productize/">Productize your service offer</a></li>
          <li><a href="/pricing/">Choose a Retainr plan</a></li>
          <li><a href="/client-onboarding/">Improve client onboarding</a></li>
          <li><a href="/income/">Turn skills into revenue</a></li>
        </ul>
      </article>

      <!-- Client Experience -->
      <article class="page-section">
        <span class="eyebrow">Client experience</span>
        <h2>What clients should feel after clicking through</h2>
        <p>
          A client should not feel like they are being passed between disconnected tools. They should understand what they are buying, what happens next, where to upload information, where to ask questions, how progress is tracked, and how future support can continue. Retainr's value is strongest when the buyer experience feels like one branded system rather than a loose collection of forms, invoices, folders, chat messages, and task boards.
        </p>
        <p>
          For digital creators, this matters because trust is often personal. A client hires an AI consultant, SEO expert, designer, coach, info product creator, or illustrator because they believe in that expert. The software should reinforce that trust by keeping the expert's brand visible and the process clear from first payment to renewal.
        </p>
        <ul class="check-list">
          <li>Clients see the purchased service and next steps immediately</li>
          <li>Requests, uploads, tickets, and approvals stay attached to the project</li>
          <li>Recurring plans feel like a natural continuation, not a surprise upsell</li>
          <li>The creator's brand remains the center of the client relationship</li>
        </ul>
      </article>

      <!-- Implementation Playbook -->
      <article class="page-section">
        <span class="eyebrow">Implementation playbook</span>
        <h2>How to launch this page as a working offer</h2>
        <p>
          Start with one offer that already sells manually. Write the outcome in plain language, define the deliverables, decide what information is required from the client, and publish the offer with a signup link. After the first delivery, identify the work that should repeat monthly: reporting, check-ins, support, new creative output, implementation, optimization, or advisory access. That repeated work becomes the recurring revenue plan.
        </p>
        <p>
          Retainr should then become the place where this offer is sold and operated. The package creates the buying moment, onboarding gathers the right context, the portal centralizes the relationship, tickets handle support, and tasks keep delivery moving. This is the difference between having a page that only explains a feature and having a page that creates a complete revenue path.
        </p>
        <ul class="check-list">
          <li>Publish one starter package and one recurring upgrade</li>
          <li>Use niche-specific onboarding questions wherever possible</li>
          <li>Connect pricing, sales funnel, onboarding, and income pages through internal links</li>
          <li>Review client questions monthly and turn repeated questions into better intake prompts</li>
        </ul>
      </article>
    </div>
  </section>

  {page.faqs && page.faqs.length > 0 && (
    <section class="section ice">
      <div class="container">
        <div class="section-heading centered">
          <span class="eyebrow">FAQ</span>
          <h2>Common questions</h2>
        </div>
        <div class="faq-grid">
          {page.faqs.map((item) => (
            <article class="faq-item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
  <Testimonials />
</BaseLayout>
