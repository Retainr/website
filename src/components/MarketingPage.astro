---
import type { MarketingPage } from "@/data/pages";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaBand from "./CtaBand.astro";
import Testimonials from "./Testimonials.astro";
import { assetDimensions } from "@/data/assets";
import { signupUrl } from "@/data/site";
import { founder } from "@/data/founder";

type Props = { page: MarketingPage };
const { page } = Astro.props;
const path = `/${page.slug}/`;
const methodSteps = ["Package", "Sell", "Onboard", "Deliver", "Retain"];
const heroImage = page.image ?? "/assets/dashboard-hero.png";
const heroImageDimensions = assetDimensions(heroImage);
const informationalSlugs = new Set([
  "brand-assets",
  "about-retainr",
  "manifesto-retainr",
  "privacy-policy",
  "help",
  "terms-conditions",
  "feedback",
  "contact",
]);
const noConversionSlugs = new Set(["brand-assets", "privacy-policy", "help", "terms-conditions", "feedback", "contact"]);
const isInformationalPage = informationalSlugs.has(page.slug);
const isFounderPage = page.slug === "about-retainr" || page.slug === "manifesto-retainr";
const showConversionFramework = !isInformationalPage;
const showFinalCta = !noConversionSlugs.has(page.slug);
const pageActions: Record<string, { label: string; href: string; download?: boolean; newTab?: boolean }[]> = {
  "alternatives-compare-agency-client-management-software": [
    { label: "Compare Retainr", href: "/compare/" },
    { label: "See Free Retainr Access", href: "/pricing/" },
  ],
  "brand-assets": [
    { label: "Download Retainr Logo", href: "/assets/retainr-logo.svg", download: true },
    { label: "About Retainr", href: "/about-retainr/" },
  ],
  "about-retainr": [
    { label: "Start free forever", href: signupUrl },
    { label: "Why Retainr is free", href: "/manifesto-retainr/" },
  ],
  "manifesto-retainr": [
    { label: "Read the founder story", href: "/about-retainr/" },
    { label: "See free Retainr access", href: "/pricing/" },
  ],
  "privacy-policy": [
    { label: "Contact Retainr", href: "mailto:contact@retainr.io" },
    { label: "Read Terms", href: "/terms-conditions/" },
  ],
  "terms-conditions": [
    { label: "Contact Retainr", href: "mailto:contact@retainr.io" },
    { label: "Read Privacy Policy", href: "/privacy-policy/" },
  ],
  help: [
    { label: "Watch Tutorials", href: "https://www.youtube.com/@Retainr", newTab: true },
    { label: "Contact Support", href: "mailto:contact@retainr.io" },
  ],
  feedback: [
    { label: "Send Feedback", href: "mailto:contact@retainr.io?subject=Retainr%20feedback" },
    { label: "Request a Feature", href: "https://x.com/intent/tweet?text=@Retainr_io%20I%20have%20a%20feature%20suggestion%20for%20improving%20your%20platform.", newTab: true },
  ],
  contact: [
    { label: "Email Retainr", href: "mailto:contact@retainr.io" },
    { label: "Visit Knowledge Base", href: "/help/" },
  ],
};
const heroActions = pageActions[page.slug] ?? [
  { label: "Start free forever", href: signupUrl },
  { label: "See what is included", href: "/pricing/" },
];
const faqSchema = page.faqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: page.faqs.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    }
  : undefined;
---

<BaseLayout title={page.title} description={page.description} path={path}>
  {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
  <!-- Hero -->
  <section class="hero marketing-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{page.eyebrow ?? "Retainr"}</span>
        <h1>{page.hero}</h1>
        <p>{page.subhero}</p>
        <div class="hero-actions">
          {heroActions.map((action, index) => {
            return (
              <a
                href={action.href}
                class:list={["button", { ghost: index > 0 }]}
                download={action.download || undefined}
                target={action.newTab ? "_blank" : undefined}
                rel={action.newTab ? "noopener noreferrer" : undefined}
              >
                {action.label}
              </a>
            );
          })}
        </div>
      </div>
      {isInformationalPage ? (
        <div class="hero-visual informational-hero-visual">
          <div class="informational-hero-panel">
            <img src="/assets/retainr-logo.svg" alt="Retainr" width="148" height="42" />
            <span>{page.eyebrow ?? "Retainr"}</span>
            <strong>{page.description}</strong>
            <div aria-hidden="true">
              <i></i><i></i><i></i>
            </div>
          </div>
        </div>
      ) : (
      <div class="hero-visual">
        <div class="product-frame">
          <img
            src={heroImage}
            alt={`${page.hero} in Retainr`}
            width={heroImageDimensions.width}
            height={heroImageDimensions.height}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <div class="hero-ticket hero-ticket-top">
          <strong>Magic Link</strong>
          <span>Send this offer into the right signup flow</span>
        </div>
        <div class="hero-ticket hero-ticket-bottom">
          <strong>White Label</strong>
          <span>Keep your specialist brand at the center</span>
        </div>
      </div>
      )}
    </div>
  </section>

  {showConversionFramework && <section class="page-method-band" aria-label="Retainr method steps">
    <div class="container page-method-shell">
      <span class="page-method-label">Retainr Method</span>
      <div class="page-method-steps">
        {methodSteps.map((step, index) => (
          <span>
            <strong>{String(index + 1).padStart(2, "0")}</strong>
            {step}
          </span>
        ))}
      </div>
    </div>
  </section>}

  <!-- Special Section: Brand Assets -->
  {page.slug === "brand-assets" && (
    <section class="section ice">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Color palette</span>
          <h2>Same Retainr colors, cleaner system</h2>
        </div>
        <div class="swatch-grid">
          {["#FF4D18", "#FFD540", "#FFFFFF", "#1d2130", "#EDF8FD", "#B7CD4B"].map((hex) => (
            <div class="swatch">
              <div class="swatch-color" style={`background:${hex}`}></div>
              <div class="swatch-label">{hex}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Dynamic Page Sections -->
  <section class:list={["section", "programme-section", { "informational-content-section": isInformationalPage }]}>
    <div class="container programme-layout">
      <aside class="programme-intro">
        {isFounderPage ? (
          <>
            <span class="eyebrow">Independent builder</span>
            <h2>Retainr has a real person behind it.</h2>
            <p>{founder.name} builds Retainr in public for freelancers who want a clearer client business without another platform subscription.</p>
            <a href="/manifesto-retainr/" class="text-link">
              Read why Retainr is free <span aria-hidden="true">→</span>
            </a>
          </>
        ) : isInformationalPage ? (
          <>
            <span class="eyebrow">{page.eyebrow ?? "Retainr"}</span>
            <h2>Clear information, organized for quick reference.</h2>
            <p>Use the sections alongside this summary to find the relevant details without navigating through sales content.</p>
            <a href="/contact/" class="text-link">Contact Retainr <span aria-hidden="true">→</span></a>
          </>
        ) : (
          <>
            <span class="eyebrow">The Retainr Method</span>
            <h2>Move from a clear offer to a client relationship that lasts.</h2>
            <p>Each part of the experience should remove uncertainty for the buyer and make the next step obvious.</p>
            <a href="/method/" class="text-link">Explore the complete method <span aria-hidden="true">→</span></a>
          </>
        )}
      </aside>
      <div class="programme-steps">
        {page.sections.map((section, index) => (
          <article class="programme-step">
            <div class="programme-step-number">{String(index + 1).padStart(2, "0")}</div>
            <div class="programme-step-copy">
              <h2>{section.title}</h2>
              <p>{section.body}</p>
              {section.points && (
                <ul class="check-list compact-check-list">
                  {section.points.map((point) => <li>{point}</li>)}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {showConversionFramework && <section class="section revenue-blueprint-section">
    <div class="container revenue-blueprint">
      <article class="revenue-blueprint-copy">
        <span class="eyebrow">Independent client business</span>
        <h2>Build beyond the first sale.</h2>
        <p>
          Retainr is built for niche freelancers, digital creators, and independent experts who already have trusted expertise but need a better system for selling it. The goal is not just to publish a page, collect a lead, or close one project. The goal is to turn a buyer into a client, a client into a repeat client, and repeat work into a clear recurring offer that can be managed without scattered tools.
        </p>
      </article>
      <ol class="revenue-path" aria-label="Retainr recurring revenue path">
        <li><strong>Package</strong><span>Make the first outcome easy to understand and buy.</span></li>
        <li><strong>Onboard</strong><span>Collect payment, context, files, and expectations.</span></li>
        <li><strong>Deliver</strong><span>Keep progress, requests, and approvals in one branded place.</span></li>
        <li><strong>Retain</strong><span>Turn the next ongoing need into a natural monthly plan.</span></li>
      </ol>
    </div>
  </section>}

  {showConversionFramework && <section class="section editorial-section">
    <div class="container editorial-grid">
      <article class="editorial-copy">
        <span class="eyebrow">Client experience</span>
        <h2>What clients should feel after clicking through</h2>
        <p>
          A client should not feel like they are being passed between disconnected tools. They should understand what they are buying, what happens next, where to upload information, where to ask questions, how progress is tracked, and how future support can continue. Retainr's value is strongest when the buyer experience feels like one branded system rather than a loose collection of forms, invoices, folders, chat messages, and task boards.
        </p>
        <p>
          For independent experts, this matters because trust is often personal. A client hires an AI consultant, SEO expert, designer, coach, info product creator, or illustrator because they believe in that person. The software should reinforce that trust by keeping the expert's brand visible and the process clear from first payment to renewal.
        </p>
        <ul class="check-list compact-check-list">
          <li>Clients see the purchased service and next steps immediately</li>
          <li>Requests, uploads, tickets, and approvals stay attached to the project</li>
          <li>Recurring plans feel like a natural continuation, not a surprise upsell</li>
          <li>The creator's brand remains the center of the client relationship</li>
        </ul>
      </article>

      <article class="editorial-copy editorial-copy-accent">
        <span class="eyebrow">Implementation playbook</span>
        <h2>How to launch a working offer</h2>
        <p>
          Start with one offer that already sells manually. Write the outcome in plain language, define the deliverables, decide what information is required from the client, and publish the offer with a signup link. After the first delivery, identify the work that should repeat monthly: reporting, check-ins, support, new creative output, implementation, optimization, or advisory access. That repeated work becomes the recurring revenue plan.
        </p>
        <p>
          Retainr should then become the place where this offer is sold and operated. The package creates the buying moment, onboarding gathers the right context, the portal centralizes the relationship, tickets handle support, and tasks keep delivery moving. This is the difference between explaining a service and operating a complete revenue path.
        </p>
        <ul class="check-list compact-check-list">
          <li>Publish one starter package and one recurring upgrade</li>
          <li>Use niche-specific onboarding questions wherever possible</li>
          <li>Connect pricing, sales funnel, onboarding, and income pages through internal links</li>
          <li>Review client questions monthly and turn repeated questions into better intake prompts</li>
        </ul>
      </article>
    </div>
  </section>}

  {showConversionFramework && <section class="section niche-proof-section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Built for specialist work</span>
        <h2>One method, adapted to the way your expertise creates value.</h2>
        <p>Start with the playbook closest to your business. Every path leads to niche-aware Retainr signup and onboarding.</p>
      </div>
      <div class="niche-proof-links">
        <a href="/niches/ai-experts/"><strong>AI consultants</strong><span>Audits to optimization retainers</span></a>
        <a href="/niches/seo-experts/"><strong>SEO experts</strong><span>Roadmaps to monthly growth</span></a>
        <a href="/niches/designers/"><strong>Designers</strong><span>Sprints to creative desks</span></a>
        <a href="/niches/digital-coaches/"><strong>Digital coaches</strong><span>Programs to accountability plans</span></a>
      </div>
      <div class="next-links" aria-label="Continue exploring Retainr">
        <a href="/productize/">Productize your offer <span aria-hidden="true">→</span></a>
        <a href="/client-onboarding/">Improve onboarding <span aria-hidden="true">→</span></a>
        <a href="/pricing/">See what is included <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>}

  {page.faqs && page.faqs.length > 0 && (
    <section class="section ice">
      <div class="container">
        <div class="section-heading centered">
          <span class="eyebrow">FAQ</span>
          <h2>Common questions</h2>
        </div>
        <div class="faq-grid">
          {page.faqs.map((item) => (
            <article class="faq-item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {showConversionFramework && <Testimonials />}
  {showFinalCta && <CtaBand />}
</BaseLayout>
