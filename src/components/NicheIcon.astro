---
import type { Niche } from "@/data/niches";

type Props = {
  niche: Pick<Niche, "slug" | "name">;
  variant?: "card" | "hero";
};

const { niche, variant = "card" } = Astro.props;

const iconTypes: Record<string, string> = {
  "ai-experts": "network",
  "seo-experts": "growth",
  designers: "design",
  "life-coaches": "target",
  "info-products": "book",
  cartoonists: "creative",
  nutritionists: "leaf",
  "registered-dietitians": "leaf",
  "dog-walkers": "paw",
  "ebook-novelists": "write",
  "digital-coaches": "target",
  "course-creators": "book",
  copywriters: "write",
  "video-editors": "play",
  "web-designers": "layout",
  "crypto-experts": "crypto",
  "fitness-coaches": "pulse",
  "community-managers": "community",
  "virtual-assistants": "ops",
  "notion-consultants": "systems",
  "podcast-producers": "audio",
  "ugc-creators": "play",
  "marketing-consultants": "funnel",
};

const type = iconTypes[niche.slug] ?? "systems";

const iconThemes: Record<string, { a: string; b: string; c: string; ink: string }> = {
  "ai-experts": { a: "#FF4D18", b: "#FFD540", c: "#EDF8FD", ink: "#1d2130" },
  "seo-experts": { a: "#B7CD4B", b: "#FFD540", c: "#FFFFFF", ink: "#1d2130" },
  designers: { a: "#FF4D18", b: "#EDF8FD", c: "#FFD540", ink: "#1d2130" },
  "life-coaches": { a: "#FFD540", b: "#B7CD4B", c: "#FFFFFF", ink: "#1d2130" },
  "info-products": { a: "#1d2130", b: "#FFD540", c: "#EDF8FD", ink: "#FFFFFF" },
  cartoonists: { a: "#FFD540", b: "#FF4D18", c: "#FFFFFF", ink: "#1d2130" },
  nutritionists: { a: "#B7CD4B", b: "#EDF8FD", c: "#FFD540", ink: "#1d2130" },
  "registered-dietitians": { a: "#B7CD4B", b: "#FFFFFF", c: "#EDF8FD", ink: "#1d2130" },
  "dog-walkers": { a: "#FFD540", b: "#B7CD4B", c: "#FFFFFF", ink: "#1d2130" },
  "ebook-novelists": { a: "#1d2130", b: "#EDF8FD", c: "#FFD540", ink: "#FFFFFF" },
  "digital-coaches": { a: "#FF4D18", b: "#FFD540", c: "#FFFFFF", ink: "#1d2130" },
  "course-creators": { a: "#FFD540", b: "#EDF8FD", c: "#B7CD4B", ink: "#1d2130" },
  copywriters: { a: "#FF4D18", b: "#FFFFFF", c: "#FFD540", ink: "#1d2130" },
  "video-editors": { a: "#1d2130", b: "#FF4D18", c: "#FFD540", ink: "#FFFFFF" },
  "web-designers": { a: "#EDF8FD", b: "#FF4D18", c: "#FFD540", ink: "#1d2130" },
  "crypto-experts": { a: "#1d2130", b: "#B7CD4B", c: "#FFD540", ink: "#FFFFFF" },
  "fitness-coaches": { a: "#FF4D18", b: "#B7CD4B", c: "#FFFFFF", ink: "#1d2130" },
  "community-managers": { a: "#EDF8FD", b: "#FFD540", c: "#FF4D18", ink: "#1d2130" },
  "virtual-assistants": { a: "#1d2130", b: "#EDF8FD", c: "#B7CD4B", ink: "#FFFFFF" },
  "notion-consultants": { a: "#FFFFFF", b: "#1d2130", c: "#FFD540", ink: "#1d2130" },
  "podcast-producers": { a: "#1d2130", b: "#FFD540", c: "#FF4D18", ink: "#FFFFFF" },
  "ugc-creators": { a: "#FF4D18", b: "#EDF8FD", c: "#FFD540", ink: "#1d2130" },
  "marketing-consultants": { a: "#FFD540", b: "#1d2130", c: "#B7CD4B", ink: "#1d2130" },
};

const theme = iconThemes[niche.slug] ?? { a: "#FF4D18", b: "#FFD540", c: "#EDF8FD", ink: "#1d2130" };
const iconStyle = `--icon-a:${theme.a};--icon-b:${theme.b};--icon-c:${theme.c};--icon-ink:${theme.ink};`;
---

<span class:list={["niche-icon", `niche-icon-${variant}`]} style={iconStyle} aria-hidden="true">
  <span class="icon-aura"></span>
  <span class="icon-plate"></span>
  <svg viewBox="0 0 64 64" fill="none" focusable="false">
    {type === "network" && (
      <g>
        <path
          d="M32 13l3.8 11.2L47 28l-11.2 3.8L32 43l-3.8-11.2L17 28l11.2-3.8L32 13Z"
          fill="currentColor"
          stroke="none"
        />
        <path d="M47 39l1.8 5.2L54 46l-5.2 1.8L47 53l-1.8-5.2L40 46l5.2-1.8L47 39Z" />
        <circle cx="17" cy="46" r="2.5" fill="currentColor" stroke="none" />
      </g>
    )}
    {type === "growth" && (
      <g>
        <circle cx="27" cy="28" r="13" />
        <path d="M36.5 37.5L49 50" />
        <path d="M20 32l6-6 5 5 9-10" />
        <path d="M34 21h6v6" />
      </g>
    )}
    {type === "design" && (
      <g>
        <path d="M32 12l18 20-18 20-18-20 18-20Z" />
        <path d="M22 32h20M32 12v40" />
        <circle cx="32" cy="32" r="5" />
      </g>
    )}
    {type === "target" && (
      <g>
        <circle cx="32" cy="32" r="19" />
        <circle cx="32" cy="32" r="10" />
        <circle cx="32" cy="32" r="3" />
        <path d="M44 20l7-7M51 13v9M51 13h-9" />
      </g>
    )}
    {type === "book" && (
      <g>
        <path d="M17 17h15c5 0 8 3 8 8v24H25c-5 0-8-3-8-8V17Z" />
        <path d="M40 21h7v28h-7M25 26h8M25 34h8" />
      </g>
    )}
    {type === "creative" && (
      <g>
        <path d="M18 44c4-15 14-25 28-30-5 14-15 24-30 28" />
        <path d="M20 44c7 4 16 2 22-4" />
        <circle cx="42" cy="21" r="3" />
      </g>
    )}
    {type === "leaf" && (
      <g>
        <path d="M49 16C31 15 18 24 18 38c0 8 6 13 14 13 14 0 21-15 17-35Z" />
        <path d="M18 48c7-12 17-20 30-27" />
        <path d="M31 28c1 6 5 10 11 12" />
      </g>
    )}
    {type === "paw" && (
      <g>
        <circle cx="22" cy="24" r="5" />
        <circle cx="32" cy="19" r="5" />
        <circle cx="42" cy="24" r="5" />
        <path d="M21 44c0-8 5-14 11-14s11 6 11 14c0 5-4 8-11 8s-11-3-11-8Z" />
      </g>
    )}
    {type === "write" && (
      <g>
        <path d="M18 46l5-14 20-20 9 9-20 20-14 5Z" />
        <path d="M38 17l9 9M23 32l9 9M16 52h34" />
      </g>
    )}
    {type === "play" && (
      <g>
        <rect x="15" y="18" width="34" height="28" rx="5" />
        <path d="M28 26l12 6-12 6V26Z" />
        <path d="M21 52h22" />
      </g>
    )}
    {type === "layout" && (
      <g>
        <rect x="14" y="17" width="36" height="30" rx="4" />
        <path d="M14 27h36M25 27v20M31 36h13" />
      </g>
    )}
    {type === "crypto" && (
      <g>
        <path d="M32 12l18 10v20L32 52 14 42V22l18-10Z" />
        <path d="M25 23h11c4 0 6 2 6 5 0 2-1 4-4 5 3 1 5 3 5 6 0 4-3 6-8 6H25V23Z" />
        <path d="M29 18v10m7-10v10M29 38v10m7-10v10" />
      </g>
    )}
    {type === "pulse" && (
      <g>
        <path d="M14 35h9l5-14 8 26 5-12h9" />
        <circle cx="32" cy="32" r="20" />
      </g>
    )}
    {type === "community" && (
      <g>
        <circle cx="24" cy="25" r="6" />
        <circle cx="40" cy="25" r="6" />
        <path d="M14 48c2-9 8-14 18-14s16 5 18 14" />
        <path d="M20 48c1-5 5-8 12-8s11 3 12 8" />
      </g>
    )}
    {type === "ops" && (
      <g>
        <rect x="17" y="17" width="30" height="34" rx="4" />
        <path d="M24 27h16M24 36h16M24 45h10" />
        <path d="M25 12h14v8H25z" />
      </g>
    )}
    {type === "systems" && (
      <g>
        <rect x="15" y="15" width="14" height="14" />
        <rect x="35" y="15" width="14" height="14" />
        <rect x="15" y="35" width="14" height="14" />
        <rect x="35" y="35" width="14" height="14" />
        <path d="M29 22h6M22 29v6M42 29v6M29 42h6" />
      </g>
    )}
    {type === "audio" && (
      <g>
        <rect x="25" y="13" width="14" height="28" rx="7" />
        <path d="M18 30c0 8 6 14 14 14s14-6 14-14M32 44v8M24 52h16" />
      </g>
    )}
    {type === "funnel" && (
      <g>
        <path d="M15 17h34L36 33v13l-8 5V33L15 17Z" />
        <path d="M22 24h20" />
      </g>
    )}
  </svg>
</span>

<style>
  .niche-icon {
    position: relative;
    width: 78px;
    height: 78px;
    display: grid;
    place-items: center;
    border: 2px solid #1d2130;
    border-radius: 8px;
    background:
      linear-gradient(90deg, rgba(29, 33, 48, 0.08) 0 1px, transparent 1px 12px),
      radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.9), transparent 24%),
      linear-gradient(135deg, var(--icon-a), var(--icon-b) 54%, var(--icon-c));
    color: var(--icon-ink);
    flex-shrink: 0;
    box-shadow:
      6px 6px 0 #1d2130,
      0 18px 44px color-mix(in srgb, var(--icon-a), transparent 62%),
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      inset 0 -16px 34px rgba(29, 33, 48, 0.14);
    transition: transform 0.2s ease;
    overflow: hidden;
    isolation: isolate;
  }

  .niche-icon::before {
    content: "";
    position: absolute;
    inset: -22%;
    background:
      linear-gradient(115deg, transparent 0 32%, rgba(255, 255, 255, 0.68) 42%, transparent 54%),
      radial-gradient(circle at 82% 22%, rgba(255, 255, 255, 0.52), transparent 19%);
    transform: translateX(-18%) rotate(8deg);
    opacity: 0.7;
    z-index: 1;
  }

  .niche-icon::after {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 7px;
    box-shadow:
      inset 0 0 0 1px rgba(29, 33, 48, 0.08),
      inset 0 -10px 22px rgba(29, 33, 48, 0.1);
    z-index: 3;
  }

  .icon-aura {
    position: absolute;
    width: 74%;
    aspect-ratio: 1;
    border-radius: 999px;
    background: color-mix(in srgb, var(--icon-c), transparent 20%);
    filter: blur(15px);
    opacity: 0.78;
    transform: translate(18%, -16%);
    z-index: 0;
  }

  .icon-plate {
    position: absolute;
    inset: 14px;
    border-radius: 7px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.32)),
      color-mix(in srgb, var(--icon-a), transparent 68%);
    box-shadow:
      inset 0 0 0 1px rgba(29, 33, 48, 0.12),
      0 10px 20px rgba(29, 33, 48, 0.08);
    z-index: 2;
  }

  .niche-icon-hero {
    width: min(58%, 190px);
    height: auto;
    aspect-ratio: 1;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.28);
  }

  svg {
    position: relative;
    z-index: 4;
    width: 55%;
    height: 55%;
    stroke: currentColor;
    stroke-width: 4.1;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter:
      drop-shadow(0 1px 0 rgba(255, 255, 255, 0.34))
      drop-shadow(0 8px 12px rgba(29, 33, 48, 0.2));
  }

  svg :global(rect),
  svg :global(path),
  svg :global(circle) {
    vector-effect: non-scaling-stroke;
  }
</style>
