---
import { founder } from "@/data/founder";
---

<a
  class="footer-builder-card"
  href="/about-retainr/"
  aria-label={`Learn why ${founder.name} built Retainr`}
>
  <span class="footer-builder-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM3.56 9h3.56v11.45H3.56V9Z"></path>
    </svg>
  </span>
  <span class="footer-builder-copy">
    <strong>Built independently by {founder.name}</strong>
    <small>Why Retainr is free forever</small>
  </span>
</a>
