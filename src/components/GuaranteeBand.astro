---
const {
  title = "Start small. Keep every capability.",
  subtitle = "Retainr is free forever, so you can build a real offer, invite your team, and test the complete client journey without choosing a plan."
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="section-heading centered" style="max-width: 720px; margin-bottom: 40px;">
      <span class="eyebrow">A Practical First Step</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="guarantee-grid">
      <article class="guarantee-card">
        <div class="guarantee-mark">$0</div>
        <h3>Use the complete client journey</h3>
        <p>
          Publish an offer, open its signup flow, invite collaborators, and run onboarding and delivery from the client's point of view.
        </p>
      </article>

      <article class="guarantee-card">
        <div class="guarantee-mark">0%</div>
        <h3>Retainr adds no transaction fee</h3>
        <p>
          Retainr charges 0% transaction fees, so the platform does not take a percentage of each client payment. Your connected payment provider may still charge its standard processing fees.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .guarantee-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .guarantee-card {
    position: relative;
    overflow: hidden;
    background: var(--white);
    border: 2px solid var(--ink);
    border-radius: 8px;
    padding: 28px 24px;
    box-shadow: 8px 8px 0 var(--yellow), 0 24px 54px rgba(29, 33, 48, 0.08);
  }

  .guarantee-card::after {
    position: absolute;
    right: -34px;
    bottom: -38px;
    width: 112px;
    height: 112px;
    border: 22px solid rgba(237, 248, 253, 0.9);
    border-radius: 999px;
    content: "";
  }

  .guarantee-mark {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: var(--yellow);
    color: var(--ink);
    font-weight: 950;
    box-shadow: 5px 5px 0 var(--ink);
    margin-bottom: 14px;
  }

  .guarantee-card h3 {
    position: relative;
    z-index: 1;
    margin: 0 0 12px;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .guarantee-card p {
    position: relative;
    z-index: 1;
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 768px) {
    .guarantee-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
