---
const {
  title = "Risk-Free. Built for Results.",
  subtitle = "We designed Retainr so you can test it with zero risk."
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="section-heading centered" style="max-width: 720px; margin-bottom: 40px;">
      <span class="eyebrow">Zero Risk</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="guarantee-grid">
      <!-- Guarantee 1 -->
      <article class="guarantee-card">
        <div class="guarantee-mark">14</div>
        <h3>14-Day "Test Without Risk" Guarantee</h3>
        <p>
          Try Retainr for a full 14 days. If it doesn't help you package and sell your services more clearly,
          just email support and we'll refund you, no questions asked.
        </p>
      </article>

      <!-- Guarantee 2 -->
      <article class="guarantee-card">
        <div class="guarantee-mark">01</div>
        <h3>"Get Your First Retainer" Promise</h3>
        <p>
          Use Retainr to publish at least one offer. If you don't land a paying client within 60 days,
          we'll give you a free strategy call and extend your access at no extra cost.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .guarantee-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .guarantee-card {
    position: relative;
    overflow: hidden;
    background: var(--white);
    border: 2px solid var(--ink);
    border-radius: 8px;
    padding: 28px 24px;
    box-shadow: 8px 8px 0 var(--yellow), 0 24px 54px rgba(29, 33, 48, 0.08);
  }

  .guarantee-card::after {
    position: absolute;
    right: -34px;
    bottom: -38px;
    width: 112px;
    height: 112px;
    border: 22px solid rgba(237, 248, 253, 0.9);
    border-radius: 999px;
    content: "";
  }

  .guarantee-mark {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: linear-gradient(135deg, var(--orange), var(--yellow));
    color: var(--ink);
    font-weight: 950;
    box-shadow: 5px 5px 0 var(--ink);
    margin-bottom: 14px;
  }

  .guarantee-card h3 {
    position: relative;
    z-index: 1;
    margin: 0 0 12px;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .guarantee-card p {
    position: relative;
    z-index: 1;
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 768px) {
    .guarantee-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
