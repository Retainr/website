---
import "../styles/global.css";
import CrispChat from "@/components/CrispChat.astro";
import ConversionTracking from "@/components/ConversionTracking.astro";
import { companyLinks, loginUrl, navLinks, resourceLinks, signupUrl, solutionLinks } from "@/data/site";

type Props = {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  type?: "website" | "article";
};

const {
  title,
  description = "Retainr helps digital creators and niche experts package expertise, sell paid services, onboard clients, and build recurring revenue from one branded platform.",
  path = "/",
  image = "/assets/dashboard-hero.png",
  type = "website",
} = Astro.props;
const canonical = new URL(path, Astro.site ?? "https://www.retainr.io").toString();
const socialImage = new URL(image, Astro.site ?? "https://www.retainr.io").toString();
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="container nav">
        <a href="/" class="logo" aria-label="Retainr home">
          <img src="/assets/retainr-logo.svg" alt="Retainr" width="148" height="42" />
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          {navLinks.map((link) => {
            const linkPath = link.href.replace(/\/+$/, "") || "/";
            return <a href={link.href} aria-current={currentPath === linkPath ? "page" : undefined}>{link.label}</a>;
          })}
        </nav>
        <div class="nav-actions">
          <a href={loginUrl} class="button ghost">Login</a>
          <a href={signupUrl} class="button">Sell Today</a>
        </div>
        <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false">
          <span></span>
        </button>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <a href="/" class="logo" aria-label="Retainr home">
              <img src="/assets/retainr-logo.svg" alt="Retainr" width="148" height="42" />
            </a>
            <h3>Build Your Method</h3>
            <p class="muted">Turn trusted expertise into packaged offers, paid signup links, guided delivery, and recurring client revenue.</p>
            <a href={signupUrl} class="button">Start Your $1 Trial</a>
          </div>
          <div class="footer-col">
            <h3>Freelancer & Creator Systems</h3>
            <div class="footer-links">
              {solutionLinks.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          </div>
          <div class="footer-col">
            <h3>Company</h3>
            <div class="footer-links">
              <a href="https://ambassador.retainr.io">Affiliates Program</a>
              {companyLinks.map((link) => <a href={link.href}>{link.label}</a>)}
              <a href={loginUrl}>Log In</a>
              <a href={signupUrl}>Sign Up</a>
            </div>
          </div>
          <div class="footer-col">
            <h3>Resources</h3>
            <div class="footer-links">
              {resourceLinks.map((link) => <a href={link.href}>{link.label}</a>)}
              <a href="https://status.retainr.io">Status Page</a>
            </div>

            <form class="email-form" action={signupUrl} method="get">
              <input type="email" name="email" placeholder="Enter work email" aria-label="Work email" required />
              <button class="button yellow" type="submit">Start Selling</button>
            </form>
            <p class="muted">Begin promoting your niche services and managing paid client orders.</p>

            <div class="social-links">
              <a href="https://x.com/Retainr_io">X</a>
              <a href="https://tiktok.com/@retainr.io">TikTok</a>
              <a href="https://www.youtube.com/@Retainr">YouTube</a>
              <a href="https://www.linkedin.com/company/retainr-io/">LinkedIn</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>Retainr™ (by SimpliXio Pte Ltd. UEN 202428793Z)</span>
          <span>We contribute 1% of revenue to Stripe Climate</span>
        </div>
      </div>
    </footer>
    <script>
      const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
      const closeMenu = () => {
        document.body.classList.remove("menu-open");
        menuButton?.setAttribute("aria-expanded", "false");
        menuButton?.setAttribute("aria-label", "Open navigation");
      };

      menuButton?.addEventListener("click", () => {
        const isOpen = document.body.classList.toggle("menu-open");
        menuButton.setAttribute("aria-expanded", String(isOpen));
        menuButton.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");
      });

      document.querySelectorAll(".nav-links a, .nav-actions a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMenu();
          menuButton?.focus();
        }
      });

      window.matchMedia("(min-width: 981px)").addEventListener("change", (event) => {
        if (event.matches) closeMenu();
      });
    </script>
    <ConversionTracking />
    <CrispChat />
  </body>
</html>
