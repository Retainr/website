---
import "../styles/global.css";
import CrispChat from "@/components/CrispChat.astro";
import ConversionTracking from "@/components/ConversionTracking.astro";
import { comparisonLinks } from "@/data/comparisons";
import { companyLinks, loginUrl, navLinks, resourceLinks, signupLabel, signupUrl, solutionLinks } from "@/data/site";

type Props = {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  type?: "website" | "article";
  robots?: string;
};

const {
  title,
  description = "Retainr helps digital creators and niche experts package expertise, sell paid services, onboard clients, and build recurring revenue from one branded platform.",
  path = "/",
  image = "/assets/dashboard-hero.png",
  type = "website",
  robots = "index, follow, max-image-preview:large",
} = Astro.props;
const canonical = new URL(path, Astro.site ?? "https://www.retainr.io").toString();
const socialImage = new URL(image, Astro.site ?? "https://www.retainr.io").toString();
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrentPath = (href: string) => {
  const linkPath = href.replace(/\/+$/, "") || "/";
  return linkPath === "/" ? currentPath === "/" : currentPath === linkPath || currentPath.startsWith(`${linkPath}/`);
};
const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.retainr.io/#organization",
      name: "Retainr",
      url: "https://www.retainr.io/",
      logo: {
        "@type": "ImageObject",
        url: "https://www.retainr.io/assets/retainr-logo.svg",
      },
      sameAs: [
        "https://x.com/Retainr_io",
        "https://www.youtube.com/@Retainr",
        "https://www.linkedin.com/company/retainr-io/",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://www.retainr.io/#website",
      name: "Retainr",
      url: "https://www.retainr.io/",
      publisher: { "@id": "https://www.retainr.io/#organization" },
      inLanguage: "en",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#FF4D18" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:site_name" content="Retainr" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <div class="container nav">
        <a href="/" class="logo" aria-label="Retainr home">
          <img src="/assets/retainr-logo.svg" alt="Retainr" width="148" height="42" />
        </a>
        <nav id="primary-navigation" class="nav-links" aria-label="Primary navigation">
          {navLinks.map((link) => {
            return <a href={link.href} aria-current={isCurrentPath(link.href) ? "page" : undefined}>{link.label}</a>;
          })}
        </nav>
        <div id="navigation-actions" class="nav-actions">
          <a href={loginUrl} class="button ghost">Login</a>
          <a href={signupUrl} class="button">{signupLabel}</a>
        </div>
        <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-navigation navigation-actions">
          <span></span>
        </button>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-brand-row">
          <div class="footer-brand-copy">
            <a href="/" class="logo" aria-label="Retainr home">
              <img src="/assets/retainr-logo.svg" alt="Retainr" width="148" height="42" />
            </a>
            <div>
              <h2>Build your method. Keep the relationship.</h2>
              <p class="muted">Turn trusted expertise into packaged offers, guided delivery, and recurring client revenue.</p>
            </div>
          </div>
          <div class="footer-start-panel">
            <strong>Start with one real client journey.</strong>
            <form class="email-form" action={signupUrl} method="get">
              <input type="email" name="email" placeholder="Enter work email" aria-label="Work email" required />
              <button class="button yellow" type="submit">Start free</button>
            </form>
            <span>Free forever. No plans, seat fees, or feature limits.</span>
          </div>
        </div>
        <div class="footer-link-grid">
          <div class="footer-col">
            <h3>Freelancer & Creator Systems</h3>
            <div class="footer-links">
              {solutionLinks.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          </div>
          <div class="footer-col">
            <h3>Compare</h3>
            <div class="footer-links">
              <a href="/compare/"><strong>All Retainr comparisons</strong></a>
              {comparisonLinks.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          </div>
          <div class="footer-col">
            <h3>Company</h3>
            <div class="footer-links">
              <a href="https://ambassador.retainr.io">Affiliates Program</a>
              {companyLinks.map((link) => <a href={link.href}>{link.label}</a>)}
              <a href={loginUrl}>Log In</a>
              <a href={signupUrl}>Sign Up</a>
            </div>
          </div>
          <div class="footer-col">
            <h3>Resources</h3>
            <div class="footer-links">
              {resourceLinks.map((link) => <a href={link.href}>{link.label}</a>)}
              <a href="https://status.retainr.io">Status Page</a>
            </div>
            <div class="social-links">
              <a href="https://x.com/Retainr_io">X</a>
              <a href="https://tiktok.com/@retainr.io">TikTok</a>
              <a href="https://www.youtube.com/@Retainr">YouTube</a>
              <a href="https://www.linkedin.com/company/retainr-io/">LinkedIn</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>Retainr™ (by SimpliXio Pte Ltd. UEN 202428793Z)</span>
          <span>We contribute 1% of revenue to Stripe Climate</span>
        </div>
      </div>
    </footer>
    <script>
      const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
      const closeMenu = () => {
        document.body.classList.remove("menu-open");
        menuButton?.setAttribute("aria-expanded", "false");
        menuButton?.setAttribute("aria-label", "Open navigation");
      };

      menuButton?.addEventListener("click", () => {
        const isOpen = document.body.classList.toggle("menu-open");
        menuButton.setAttribute("aria-expanded", String(isOpen));
        menuButton.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");
      });

      document.querySelectorAll(".nav-links a, .nav-actions a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && document.body.classList.contains("menu-open")) {
          closeMenu();
          menuButton?.focus();
        }
      });

      window.matchMedia("(min-width: 981px)").addEventListener("change", (event) => {
        if (event.matches) closeMenu();
      });
    </script>
    <ConversionTracking />
    <CrispChat />
  </body>
</html>
